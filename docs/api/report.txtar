dew tpu sync  [dew._cli.tpu.Sync]
  zone: str | None = None  [metavar='ZONE']
  dry_run: bool = False
  name: str  [Positional]
  exclude: tuple[str, ...] = ()  [UseAppendAction]  [metavar='PATTERN']
  delete: bool = False
dew tpu train  [dew._cli.tpu.Train]
  zone: str | None = None  [metavar='ZONE']
  dry_run: bool = False
  name: str  [Positional]
  job: str = ''  [metavar='JOB']
  delete: bool = False
-- records --
dew.telemetry.records.RunRecord
  name: str
  config: JSON
  summary: JSON
  steps: int | None
  packages: Mapping[str, str]
  dew_sha: str | None = dew.telemetry.records.checkout_revision()
  device_kind: str | None = None
  devices: int | None = None
  processes: int | None = None
dew.telemetry.records.FitStarted
  start_step: int
  target_steps: int | None
  resumed_from: str | None
  parameters: int
  devices: int
  device_kind: str
  processes: int
  mesh: Mapping[str, int]
  sharded: float
  seed: int | None = None
  tokens: int | None = None
  examples: int | None = None
  cadences: Mapping[str, JSON] = builtins.dict()
  groups: Mapping[str, str] | None = None
dew.telemetry.records.StepCompiled
  seconds: float
  remat: JSON
  links: Mapping[str, AxisLink]
  memory: JSON = None
  plan: JSON = None
dew.telemetry.records.CheckpointRequested
  directory: str
  local: bool = False
dew.telemetry.records.ProfileTraced
  directory: str
  steps: int
dew.telemetry.records.FitEnded
  status: Literal['completed', 'preempted', 'failed', 'interrupted', 'lowered']
  seconds: float
  error: str | None = None
  traceback: str | None = None
dew.telemetry.records.TrialFinished
  index: int
  name: str
  overrides: Mapping[str, JSON]
  value: float
dew.data.generation.GENERATION_SCHEMA = 2
dew.training.rungs.RECORD_VERSION = 2
dew.nn.kernels.templates.report.KERNEL_PROTO_VERSION = 4
