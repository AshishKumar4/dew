+// The extents the kernels round a call's to as they stride its buffers: a sequence's rows to their 128-row
+// block, the head size to 32. Dew's: the handlers address the scratch dew_flash_attn allocates by them, and the
+// library states that scratch's extents (`dew_flash_mha_fwd_scratch`, `dew_flash_mha_bwd_scratch`,
+// `dew_flash_mha_varlen_bwd_scratch`).
+inline int64_t dew_rounded_rows(int64_t rows) { return (rows + 127) / 128 * 128; }
+inline int64_t dew_rounded_head(int64_t head_size) { return (head_size + 31) / 32 * 32; }
