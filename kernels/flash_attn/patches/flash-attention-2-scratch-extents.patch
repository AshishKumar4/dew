+// A dense backward's scratch: softmax_d [batch, heads, seqlen_q rounded], then dq_accum [batch, seqlen_q
+// rounded, heads, head size rounded], into `extents`' seven.
+extern "C" void dew_flash_mha_bwd_scratch(int64_t batch, int64_t seqlen_q, int64_t heads, int64_t head_size,
+                                          int64_t *extents) {
+    const int64_t rows = dew_rounded_rows(seqlen_q);
+    const int64_t found[7] = {batch, heads, rows, batch, rows, heads, dew_rounded_head(head_size)};
+    for (int i = 0; i < 7; ++i) { extents[i] = found[i]; }
+}
+
+// A packed backward's scratch: softmax_d [batch, heads, max_seqlen_q rounded], then dq_accum [total_q + 128 *
+// batch, heads, head size rounded], each sequence's rows a block apart (`mha_varlen_bwd_impl`), into
+// `extents`' six.
+extern "C" void dew_flash_mha_varlen_bwd_scratch(int64_t total_q, int64_t batch, int64_t heads,
+                                                 int64_t max_seqlen_q, int64_t head_size, int64_t *extents) {
+    const int64_t found[6] = {batch, heads, dew_rounded_rows(max_seqlen_q), total_q + dew_rounded_rows(1) * batch,
+                              heads, dew_rounded_head(head_size)};
+    for (int i = 0; i < 6; ++i) { extents[i] = found[i]; }
+}
