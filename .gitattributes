checkpoint filter=lfs diff=lfs merge=lfs -text

# The notebooks are tutorials, not the codebase; keep them out of the language statistics.
*.ipynb linguist-documentation

# Lanes add changelog entries side by side: a merge keeps both sides' new lines where neither removed or
# rewrote one, and stops on a conflict anywhere else (tools/changelog_merge.py says how a clone names it).
CHANGELOG.md merge=changelog
