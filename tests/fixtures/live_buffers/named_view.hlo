HloModule m, entry_computation_layout={(f32[2]{0})->f32[2]{0}}

body {
  p = f32[2]{0} parameter(0)
  c = f32[2]{0} bitcast(p), metadata={op_name="jit(f)/jvp(g)/reshape"}
  ROOT x = f32[2]{0} exponential(c), metadata={op_name="jit(f)/transpose(jvp(g))/exp"}
}

ENTRY e {
  a = f32[2]{0} parameter(0)
  ROOT f = f32[2]{0} fusion(a), kind=kLoop, calls=body
}
