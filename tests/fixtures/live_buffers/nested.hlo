HloModule m, entry_computation_layout={(f32[2]{0})->f32[2]{0}}

inner {
  p = f32[2]{0} parameter(0)
  ROOT n = f32[2]{0} negate(p), metadata={op_name="jit(f)/jvp(g)/neg"}
}

outer {
  p = f32[2]{0} parameter(0)
  ROOT i = f32[2]{0} fusion(p), kind=kLoop, calls=inner
}

ENTRY e {
  a = f32[2]{0} parameter(0)
  ROOT f = f32[2]{0} fusion(a), kind=kCustom, calls=outer
}
