HloModule m, entry_computation_layout={(f32[2,3]{1,0})->f32[3,2]{1,0}}

body {
  p = f32[2,3]{1,0} parameter(0)
  ROOT t = f32[3,2]{1,0} transpose(p), dimensions={1,0}, metadata={op_name="jit(f)/transpose(jvp(g))/transpose"}
}

ENTRY e {
