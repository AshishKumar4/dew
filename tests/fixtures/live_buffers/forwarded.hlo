HloModule m, entry_computation_layout={(f32[2]{0})->f32[2]{0}}

inner {
  p = f32[2]{0} parameter(0)
  ROOT c = f32[2]{0} bitcast(p)
}

outer {
  q = f32[2]{0} parameter(0)
  i = f32[2]{0} fusion(q), kind=kLoop, calls=inner
  ROOT x = f32[2]{0} exponential(i), metadata={op_name="jit(f)/jvp(g)/exp"}
}

ENTRY e {
  a = f32[2]{0} parameter(0)
  ROOT f = f32[2]{0} fusion(a), kind=kCustom, calls=outer
}
