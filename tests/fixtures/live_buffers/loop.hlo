  loop = (f32[4,2]{1,0}, f32[4,2]{1,0}, f32[4,2]{1,0}, f32[4,2]{1,0}, f32[4,4]{1,0}, f32[4,2]{1,0}, f32[4,2]{1,0}, s32[], f32[4,2]{1,0}, f32[4,2]{1,0}, f32[4,2]{1,0}) while(init), condition=condition, body=body, backend_config={"known_trip_count":{"n":"STEPS"},"known_init_step":{"init":"0","step":"1"},"known_induction_variable":{"tuple_index":"7"}}, metadata={op_name="jit(f)/jvp(g)/while"}
  ROOT x = f32[4,2]{1,0} get-tuple-element(loop), index=0
}
