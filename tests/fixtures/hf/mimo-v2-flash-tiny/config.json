    "full_attention": {
      "partial_rotary_factor": 0.334,
      "rope_theta": 5000000.0,
      "rope_type": "default"
    },
    "sliding_attention": {
      "partial_rotary_factor": 0.334,
      "rope_theta": 10000.0,
      "rope_type": "default"
    }
  },
  "routed_scaling_factor": 1.5,
  "sliding_window": 5,
  "tie_word_embeddings": false,
  "topk_group": 1,
  "transformers_version": "5.16.1",
  "use_cache": true,
  "v_head_dim": 8,
  "vocab_size": 64
