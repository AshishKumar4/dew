    "dense",
    "sparse",
    "sparse"
  ],
  "model_type": "mimo_v2_flash",
  "moe_intermediate_size": 16,
  "n_group": 2,
  "n_routed_experts": 4,
  "norm_topk_prob": true,
  "num_attention_heads": 4,
