{
  "architectures": [
    "DoryForCausalLM"
  ],
  "model_type": "dory",
  "vocab_size": 64,
  "hidden_size": 32,
  "num_hidden_layers": 8,
  "intermediate_size": 48,
  "num_attention_heads": 4,
  "num_key_value_heads": 2,
  "head_dim": 16,
  "max_position_embeddings": 64,
  "tie_word_embeddings": false,
  "hidden_act": "silu",
  "initializer_range": 0.0177,
  "sliding_window": 5,
  "ngpt_alpha_init": 0.05,
  "attention_output_gate_logit_scale_init": null,
  "mlp_bias": false,
  "attention_bias": false,
  "n_input_layers": 2,
  "n_recurrent_layers": 4,
  "n_output_layers": 2,
  "n_recurrent_loops": 2,
  "layer_types": [
    "sliding_attention",
    "mlp",
    "full_attention",
    "mlp",
    "sliding_attention",
    "mlp",
    "full_attention",
    "mlp"
  ],
  "rope_parameters": {
    "sliding_attention": {
      "rope_type": "default",
      "rope_theta": 10000,
      "partial_rotary_factor": 1.0
    },
    "full_attention": {
      "rope_type": "default",
      "rope_theta": 1000000,
      "partial_rotary_factor": 1.0
    }
  },
  "bos_token_id": 1,
  "eos_token_id": [
    2,
    11
  ],
  "pad_token_id": 11,
  "dtype": "float32"
}
