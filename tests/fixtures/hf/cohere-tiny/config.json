{
  "architectures": [
    "CohereForCausalLM"
  ],
  "attention_bias": true,
  "attention_dropout": 0.0,
  "bos_token_id": 1,
  "dtype": "float32",
  "eos_token_id": null,
  "hidden_act": "silu",
  "hidden_size": 32,
  "initializer_range": 0.02,
  "intermediate_size": 48,
  "layer_norm_eps": 3e-05,
  "logit_scale": 0.8333333333333334,
  "max_position_embeddings": 48,
  "model_type": "cohere",
  "num_attention_heads": 4,
  "num_hidden_layers": 2,
  "num_key_value_heads": 2,
  "pad_token_id": 0,
  "rope_parameters": {
    "rope_theta": 10000.0,
    "rope_type": "default"
  },
  "tie_word_embeddings": true,
  "transformers_version": "5.16.1",
  "use_cache": true,
  "use_qk_norm": true,
  "vocab_size": 64
}
