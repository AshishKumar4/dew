"""HyperLux 0.1.10's renderer surface `dew.rl.hyperlux` reaches: a scene, an asset pool of objects loaded from
GLB files, and the batch ray tracer its overlays' placements are posed in."""

from collections.abc import Sequence
from pathlib import Path

import jax
import numpy as np

from .camera import RGB, CameraSpec

class Mesh:
    def __init__(self, vertices: np.ndarray, indices: np.ndarray, *, color: tuple[float, float, float] = ...
                 ) -> None: ...

class Object:
    def __init__(self, name: str = ..., *, segmentation_class: int = ...) -> None: ...
    def add_mesh(self, mesh: Mesh) -> None: ...

def load_object(path: str | Path, *, fidelity: str = ..., rgb: bool = ...) -> Object: ...

class Scene:
    def __init__(self) -> None: ...
    def add_object(self, item: Object) -> None: ...
    def set_environment(self, *, ambient: tuple[float, float, float] = ...,
                        background: tuple[float, float, float] = ...) -> None: ...

class AssetPool:
    def __init__(self) -> None: ...
    def add_object(self, item: Object) -> int: ...

class Pose:
    def __init__(self, base: np.ndarray | jax.Array | None = ..., *,
                 scale: float | np.ndarray | jax.Array = ...) -> None: ...

class Placement: ...

class PlacementBatch: ...

class OutputHandle:
    @property
    def blocks(self) -> Sequence[np.ndarray]: ...

class HyperLux:
    def __init__(self, width: int, height: int, *, batch_size: int, fidelity: str = ..., num_probes: int = ...,
                 cameras: Sequence[CameraSpec] = ..., num_overlays: int = ..., max_overlay_instances: int = ...,
                 max_overlays_per_camera: int = ..., motion_blur_samples: int = ...) -> None: ...
    def init(self, scene: Scene, *, asset_pool: AssetPool | None = ...) -> None: ...
    def attach(self, camera: int, overlay: int) -> None: ...
    def spawn(self, overlay: int, asset: int) -> Placement: ...
    def placement_batch(self, placements: Sequence[Placement]) -> PlacementBatch: ...
    def set_pose(self, placements: Placement | PlacementBatch, pose: Pose) -> None: ...
    def update(self) -> None: ...
    def set_cameras(self, bases: np.ndarray | jax.Array) -> None: ...
    def set_motion_blur_cameras(self, cameras_open: np.ndarray | jax.Array,
                                cameras_close: np.ndarray | jax.Array) -> None: ...
    def render(self) -> None: ...
    @property
    def outputs(self) -> dict[RGB, OutputHandle]: ...

__all__ = ["RGB", "AssetPool", "CameraSpec", "HyperLux", "Mesh", "Object", "Placement", "PlacementBatch", "Pose",
           "Scene", "load_object"]
