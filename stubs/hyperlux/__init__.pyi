"""HyperLux 0.1.10's renderer surface `dew.rl.hyperdrone` reaches: a scene of objects and lights, an asset
pool of object assemblies, and the batch ray tracer its overlays' placements are posed in."""

from collections.abc import Sequence

import jax
import numpy as np

from .camera import CameraSpec, RGB

type Transform = np.ndarray
type Vector = tuple[float, float, float]

def make_transform(position: Sequence[float] = ..., orientation_wxyz: Sequence[float] = ...) -> Transform: ...

class Mesh:
    def __init__(self, vertices: np.ndarray, indices: np.ndarray, *, color: Vector = ...) -> None: ...

class Object:
    def __init__(self, *, name: str = ...) -> None: ...
    def add_mesh(self, mesh: Mesh) -> None: ...

class ObjectAssembly:
    def __init__(self) -> None: ...
    def add_part(self, part: Object, transform: Transform) -> None: ...

class SceneLight:
    @staticmethod
    def directional(*, direction: Vector, color: Vector) -> SceneLight: ...

class Scene:
    def __init__(self) -> None: ...
    def add_object(self, item: Object) -> None: ...
    def add_light(self, light: SceneLight) -> None: ...
    def set_environment(self, *, ambient: Vector = ..., background: Vector = ...) -> None: ...

class AssetPool:
    def __init__(self) -> None: ...
    def add_assembly(self, assembly: ObjectAssembly) -> int: ...

class Pose:
    def __init__(self, base: np.ndarray | jax.Array | None = ..., *, scale: float = ...) -> None: ...

class Placement: ...
class PlacementBatch: ...

class OutputHandle:
    @property
    def blocks(self) -> Sequence[np.ndarray]: ...

class HyperLux:
    def __init__(self, width: int, height: int, *, batch_size: int, fidelity: str = ..., num_probes: int = ...,
                 cameras: Sequence[CameraSpec] = ..., num_overlays: int = ..., max_overlay_instances: int = ...,
                 max_overlays_per_camera: int = ...) -> None: ...
    def init(self, scene: Scene, *, asset_pool: AssetPool | None = ...) -> None: ...
    def attach(self, overlay: int, camera: int) -> None: ...
    def spawn(self, overlay: int, asset: int) -> Placement: ...
    def placement_batch(self, placements: Sequence[Placement]) -> PlacementBatch: ...
    def set_pose(self, placements: Placement | PlacementBatch, pose: Pose) -> None: ...
    def update(self) -> None: ...
    def set_cameras(self, bases: np.ndarray | jax.Array) -> None: ...
    def render(self) -> None: ...
    @property
    def outputs(self) -> dict[RGB, OutputHandle]: ...
