"""DeltaTable's versioned Arrow handoff, used only by the optional delta source."""

from collections.abc import Mapping
import pyarrow.dataset as ds

class DeltaTable:
    def __init__(self, table_uri: str, version: int | None = ..., storage_options: Mapping[str, object] | None = ...) -> None: ...
    def version(self) -> int: ...
    def file_uris(self) -> list[str]: ...
    def to_pyarrow_dataset(self) -> ds.Dataset: ...
