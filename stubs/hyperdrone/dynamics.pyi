"""HyperDrone's batch of L2F quadrotors, stepped under normalized commands."""

from collections.abc import Mapping, MutableMapping

import jax
import numpy as np

class _Capsule: ...

class Sim:
    def __init__(self, count: int, *, parameters: Mapping[str, object] = ..., seed: int = ..., device: str = ...,
                 control: str = ..., actuation: str = ...) -> None: ...
    @property
    def device(self) -> str: ...
    @property
    def parameters(self) -> Mapping[str, Mapping[str, Mapping[str, object]]]: ...
    @property
    def state(self) -> MutableMapping[str, np.ndarray]: ...
    def state_dlpack(self, name: str) -> _Capsule: ...
    def reset(self, mask: np.ndarray | None = ...) -> None: ...
    def step(self, commands: np.ndarray | jax.Array) -> None: ...
