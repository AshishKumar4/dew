import io
from collections.abc import Mapping
from typing import BinaryIO, ClassVar, Literal, TextIO, overload

class AbstractFileSystem:
    protocol: ClassVar[str | tuple[str, ...]]
    cachable: ClassVar[bool]
    def __init__(self, *args: object, **storage_options: object) -> None: ...
    @classmethod
    def _strip_protocol(cls, path: str) -> str: ...
    def unstrip_protocol(self, name: str) -> str: ...
    def _parent(self, path: str) -> str: ...
    def info(self, path: str, **kwargs: object) -> dict: ...
    def ls(self, path: str, detail: bool = ..., **kwargs: object): ...
    def glob(self, path: str, **kwargs: object) -> list[str]: ...
    def find(self, path: str, **kwargs: object) -> list[str]: ...
    def exists(self, path: str, **kwargs: object) -> bool: ...
    def isfile(self, path: str) -> bool: ...
    def isdir(self, path: str) -> bool: ...
    def size(self, path: str) -> int | None: ...
    def ukey(self, path: str) -> str: ...
    def makedirs(self, path: str, exist_ok: bool = ...) -> None: ...
    def mkdir(self, path: str, **kwargs: object) -> None: ...
    def rm(self, path: str, **kwargs: object) -> None: ...
    def cat_file(self, path: str, start: int | None = ..., end: int | None = ..., **kwargs: object) -> bytes: ...
    def pipe_file(self, path: str, value: bytes, mode: str = ..., **kwargs: object) -> None: ...
    def invalidate_cache(self, path: str | None = ...) -> None: ...
    def get_file(self, rpath: str, lpath: str, **kwargs: object) -> None: ...
    @overload
    def open(self, path: str, mode: Literal['rb', 'wb', 'ab', 'xb'] = 'rb', **kwargs: object) -> BinaryIO: ...
    @overload
    def open(self, path: str, mode: Literal['r', 'w', 'a', 'rt', 'wt', 'at'], **kwargs: object) -> TextIO: ...
    @overload
    def open(self, path: str, mode: str, **kwargs: object) -> BinaryIO | TextIO: ...
    def _open(self, path: str, mode: str = ..., block_size: int | None = ..., autocommit: bool = ...,
              cache_options: Mapping[str, object] | None = ..., **kwargs: object) -> io.IOBase: ...

class AbstractBufferedFile(io.BufferedIOBase):
    fs: AbstractFileSystem
    path: str
    def __init__(self, fs: AbstractFileSystem, path: str, mode: str = ..., block_size: int | None = ...,
                 autocommit: bool = ..., cache_type: str = ..., cache_options: Mapping[str, object] | None = ...,
                 size: int | None = ..., **kwargs: object) -> None: ...
    def _fetch_range(self, start: int, end: int) -> bytes: ...
