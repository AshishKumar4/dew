// Dew's durable data store: built mixes and their indexes, kept until deleted.
// One PUT takes at most 100 MB (worker.js MAX_BYTES), so a client writes a
// larger object as parts of at most that size beside a manifest that lists
// them with their sha256s. `tools/r2_store/provision.sh dew-data`.
{
  "name": "dew-data",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "dew-data" }]
}
