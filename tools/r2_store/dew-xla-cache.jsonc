// CI's shared XLA compilation cache (tests/remote_cache.py); armada-dew2 holds its
// token as DEW_XLA_CACHE_TOKEN. `tools/r2_store/provision.sh dew-xla-cache 14`.
{
  "name": "dew-xla-cache",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "dew-xla-cache" }]
}
