// www.dewml.dev answers every request with a permanent redirect to the same
// path on dewml.dev.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dewml-www",
	"account_id": "f44999d1ddda7012e9a87729eba250f1",
	"main": "index.js",
	"compatibility_date": "2026-09-20",
	"routes": [{ "pattern": "www.dewml.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
