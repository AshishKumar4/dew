[32.311958, "o", "\u001b[38;5;38m\u256d\u2500\u001b[0m\u001b[38;5;38m  \u001b[0m\u001b[38;5;71m\u2713 \u001b[0m\u001b[1;38;5;38mCausalTransformer\u001b[0m\u001b[38;5;38m  \u001b[0m\u001b[38;5;38m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;5;38m\u2500\u256e\u001b[0m\r\n\u001b[38;5;38m\u2502\u001b[0m \u001b[2m   trained\u001b[0m\u001b[2m  \u001b[0m3 steps in 0:00:04             \u001b[38;5;38m\u2502\u001b[0m\r\n\u001b[38;5;38m\u2502\u001b[0m \u001b[2mfirst step\u001b[0m\u001b[2m  \u001b[0mafter 4.16 s                   \u001b[38;5;38m\u2502\u001b[0m\r\n\u001b[38;5;38m\u2502\u001b[0m \u001b[2m      then\u001b[0m\u001b[2m  \u001b[0m15.0 step/s                    \u001b[38;5;38m\u2502\u001b[0m\r\n\u001b[38;5;38m\u2502\u001b[0m \u001b[2m   goodput\u001b[0m\u001b[2m  \u001b[0m3.1% of the wall time in steps \u001b[38;5;38m\u2502\u001b[0m\r\n\u001b[38;5;38m\u2502\u001b[0m \u001b[2mfinal loss\u001b[0m\u001b[2m  \u001b[0m\u001b[1m5.874                         \u001b[0m \u001b[38;5;38m\u2502\u001b[0m\r\n\u001b[38;5;38m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
