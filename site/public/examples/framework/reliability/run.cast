[14.543469, "o", "\u001b[38;2;42;167;201m\u256d\u2500\u001b[0m\u001b[38;2;42;167;201m  \u001b[0m\u001b[38;2;63;174;106m\u2713 \u001b[0m\u001b[1;38;2;42;167;201mCausalTransformer\u001b[0m\u001b[38;2;42;167;201m  \u001b[0m\u001b[38;2;42;167;201m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;42;167;201m\u2500\u256e\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m   trained\u001b[0m\u001b[2m  \u001b[0m1 steps in 0:00:01             \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2mfirst step\u001b[0m\u001b[2m  \u001b[0mafter 0.68 s                   \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m   goodput\u001b[0m\u001b[2m  \u001b[0m0.1% of the wall time in steps \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2mfinal loss\u001b[0m\u001b[2m  \u001b[0m\u001b[1m5.692                         \u001b[0m \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
