[74.526498, "o", "\u001b[38;2;42;167;201m\u256d\u2500\u001b[0m\u001b[38;2;42;167;201m  \u001b[0m\u001b[38;2;63;174;106m\u2713 \u001b[0m\u001b[1;38;2;42;167;201mCausalTransformer\u001b[0m\u001b[38;2;42;167;201m  \u001b[0m\u001b[38;2;42;167;201m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;42;167;201m\u2500\u256e\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m    trained\u001b[0m\u001b[2m  \u001b[0m1000 steps in 0:01:12           \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m first step\u001b[0m\u001b[2m  \u001b[0mafter 2.05 s                    \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m       then\u001b[0m\u001b[2m  \u001b[0m14.5 step/s                     \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m    goodput\u001b[0m\u001b[2m  \u001b[0m96.4% of the wall time in steps \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2m final loss\u001b[0m\u001b[2m  \u001b[0m\u001b[1m1.201                          \u001b[0m \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2502\u001b[0m \u001b[2mval at 1000\u001b[0m\u001b[2m  \u001b[0m\u001b[2mperplexity \u001b[0m\u001b[1m4.683\u001b[0m \u001b[38;2;63;174;106m\u2193 5.0%\u001b[0m \u001b[38;2;42;167;201m\u2588\u001b[0m\u001b[38;2;139;108;217m\u2581\u001b[0m      \u001b[38;2;42;167;201m\u2502\u001b[0m\r\n\u001b[38;2;42;167;201m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[81.625582, "o", "ROMEO:\r\nThe mercy of the matter that the world hath sent\r\nOf the duke's death.                                                                                                                                  \r\n\r\n"]
[88.537634, "o", "JULIET:\r\nThey shall be so; therefore that has no man\r\nThat seems the queen that is come to such a death,\r\nAnd here I see thee by the company.                                                                     \r\n\r\n"]
