---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EditableExample from '../components/landing/EditableExample.astro';
import { example, trainingExample } from '../data/framework-examples.mjs';
import HeroOutput from '../components/landing/HeroOutput.astro';
import LiveSampler from '../components/landing/LiveSampler.astro';
import LiveText from '../components/landing/LiveText.astro';
import capture from '../data/capture.json';
import heroCode from '../data/hero.py?raw';
import framework from '../../snippets/framework.py?raw';
import samplerCell from '../data/sampler.py?raw';
import samplerSetup from '../data/sampler_setup.py?raw';
import textCell from '../data/text.py?raw';
import textRecording from '../data/text-recording.json';
import tutorials from '../generated/tutorial-cards.json';
import { live } from '../live.mjs';
import '../styles/landing.css';

const readPublic = (...parts: string[]) => readFileSync(path.join(process.cwd(), 'public', ...parts), 'utf8');
const recorded = (name: string) => {
	const root = ['examples', 'framework', name];
	return { result: JSON.parse(readPublic(...root, 'result.json')), capture: JSON.parse(readPublic(...root, 'capture.json')) };
};
const names = ['lm', 'diffusion', 'sample_public', 'jepa', 'grpo', 'pretrained', 'serving', 'mesh', 'reliability'];
const records = Object.fromEntries(names.map((name) => [name, recorded(name)]));
const fullScript = 'https://github.com/AshishKumar4/dew/blob/main/site/snippets/framework.py';
const hero = capture.hero;
const terminalReplay = JSON.parse(readPublic('hero', 'train.json'));
const expanded = [...terminalReplay.frames.at(-1).screen];
while (expanded.length < Math.max(terminalReplay.final_cursor_row + 1, terminalReplay.source_rows)) expanded.push([]);
if (JSON.stringify(expanded.slice(-terminalReplay.source_rows)) !== JSON.stringify(terminalReplay.source_final_screen)) {
	throw new Error('Training replay changes the recorded final viewport');
}
const replays = ['aurora', 'lighthouse', 'village'].map((name) => {
	const meta = JSON.parse(readPublic('hero', 'replay', name, 'meta.json'));
	if (Math.round(meta.model.parameters / 1e6) !== 176 || !/^[0-9a-f]{40}$/.test(meta.model.dew_commit)) {
		throw new Error(`replay ${name}: missing model provenance`);
	}
	return { name, ...meta };
});
const modelSize = Math.round(replays[0].model.parameters / 1e6);
const resolution = records.sample_public.result.shape.slice(1, 3).join('×');
const mesh = records.mesh.result;
const videos = Object.values(JSON.parse(readPublic('gallery', 'wan-2.1', 'manifest.json')).clips) as { video: string; poster: string; prompt: string }[];
const gallery = JSON.parse(readPublic('gallery', 'dew-176m', 'manifest.json'));
const tries = [
	...(live.endpoint && live.turnstileSitekey ? [{ name: 'Live sampler', what: 'Edit the cell and run it on a CPU kernel.', href: '/sample/' }] : []),
	{ name: 'Colab notebook', what: 'Load the model and sample it on a GPU.', href: 'https://colab.research.google.com/github/AshishKumar4/dew/blob/main/site/notebooks/sample-text-to-image.ipynb' },
	{ name: 'dewml/hybrid-dit-176m', what: 'Weights and model card on the Hub.', href: 'https://huggingface.co/dewml/hybrid-dit-176m' },
];
const reward = readPublic('examples', 'framework', 'grpo', 'tracking', 'scalars.jsonl').trim().split('\n')
	.map((line) => JSON.parse(line)).filter((row) => 'rollout/reward/mean' in row.scalars)
	.map((row) => ({ step: row.step as number, reward: row.scalars['rollout/reward/mean'] as number }));
if (reward.length !== records.grpo.result.steps) throw new Error('GRPO recording is missing reward reports');
const rewardPoints = reward.map((row) => `${40 + (row.step - 1) / Math.max(1, reward.at(-1)!.step - 1) * 300},${140 - row.reward * 100}`).join(' ');
const tutorialNames: Record<string, string> = {
	'01': 'Diffusion from scratch', '02': 'Image diffusion', '03': 'Text to image', '04': 'Samplers',
	'05': 'Language model', '06': 'I-JEPA', '07': 'Many devices', '08': 'Pretrained decoders',
};
---

<StarlightPage frontmatter={{ title: 'Dew', description: 'A JAX/Flax framework for training, generation and serving.', template: 'splash', hero: { title: 'Train models with JAX and Flax.' }, pagefind: false }} hasSidebar={false}>
	<div class="landing not-content">
		<section class="band landing-visuals" data-reveal>
			<h2 class="band-title">Trained with Dew</h2>
			<p class="framework-note"><a href="https://huggingface.co/dewml/hybrid-dit-176m">176M hybrid DiT</a> · <a href="/gallery/dew-176m/manifest.json">Prompts and settings</a></p>
			<div class="landing-image-grid">{gallery.images.map((image: { file: string; prompt: string }) => <figure>
				<img src={`/gallery/dew-176m/${image.file}`} width="256" height="256" alt={image.prompt} loading="lazy" decoding="async" />
				<figcaption>{image.prompt}</figcaption>
			</figure>)}</div>
		</section>
		<section class="band landing-videos" data-reveal>
			<h2 class="band-title">Video</h2>
			<p class="framework-note">Wan 2.1 1.3B's released weights, sampled with Dew's JAX implementation · <a href="/gallery/wan-2.1/manifest.json">Prompts and settings</a></p>
			<div class="landing-image-grid">{videos.map((clip) => <figure>
				<video data-lazy-video data-src={`/gallery/wan-2.1/${clip.video}`} poster={`/gallery/wan-2.1/${clip.poster}`} width="832" height="480" preload="none" muted loop playsinline controls aria-label={clip.prompt} />
				<figcaption>{clip.prompt}</figcaption>
			</figure>)}</div>
		</section>

		<section class="band run" data-reveal>
			<h2 class="band-title">Training</h2>
			<p class="band-lede">A small decoder trains on Tiny Shakespeare on {capture.meta.where}, then writes one sample from each of the prompts <code>ROMEO:</code> and <code>JULIET:</code>.</p>
			<div class="run-grid">
				<EditableExample code={trainingExample(heroCode)} title="train.py" />
				<HeroOutput screen={hero.screen} meta={capture.meta} seconds={hero.seconds} replay={hero.replay} rows={hero.rows} columns={hero.columns} source_rows={hero.source_rows} playbackSeconds={terminalReplay.duration} />
			</div>
			<p class="framework-note"><a href="https://github.com/AshishKumar4/dew/blob/main/site/src/data/hero.py">Full script</a></p>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Language modeling</h2>
			<p class="band-lede">The objective creates the model's variables, computes the loss and runs evaluation. <code>Trainer.fit</code> steps the optimizer, logs progress and saves checkpoints, and every model on this page trains through that one call.</p>
			<EditableExample code={example(framework, 'lm')} title="Language modeling" />
			<p class="framework-note"><a href={fullScript}>Full script</a></p>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Representation learning</h2>
			<p class="band-lede">A JEPA encoder sees part of an image and learns to predict the representations of the patches it cannot see.</p>
			<EditableExample code={example(framework, 'jepa')} title="JEPA" />
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Fine-tuning</h2>
			<p class="band-lede">Load a Hugging Face checkpoint as a Flax model, generate from it, fine-tune it with the same trainer, and save it back in the Hugging Face layout with its original tensor names.</p>
			{live.endpoint && live.turnstileSitekey && <LiveText cell={textCell} recorded={textRecording.text} models={[{ id: 'HuggingFaceTB/SmolLM2-135M-Instruct', label: 'SmolLM2 135M Instruct' }]} />}
			<EditableExample code={example(framework, 'pretrained')} title="Fine-tune Qwen3-0.6B" />
			<HeroOutput screen={records.pretrained.capture.hero.screen} meta={records.pretrained.capture.meta}
				seconds={records.pretrained.capture.hero.seconds} columns={records.pretrained.capture.hero.columns}
				source_rows={records.pretrained.capture.hero.screen.length} playbackSeconds={0} />
			<pre class="shown-output">{records.pretrained.result.export.map((file: string) => `export/${file}`).join('\n')}</pre>
			<p class="framework-note"><a href="/reference/models/">Supported families</a>: Qwen, Llama, Gemma, Mistral, DeepSeek, Mamba and multimodal decoders.</p>
		</section>

		<section class="band replay" data-replays data-reveal>
			<h2 class="band-title">Diffusion</h2>
			<p class="band-lede">The process sets how training adds noise and what the model learns to predict. At generation time a solver runs the process in reverse, and you can switch solvers without retraining.</p>
			<LiveSampler setup={samplerSetup} cell={samplerCell} colab={tries.find((entry) => entry.name === 'Colab notebook')!.href} />
			<EditableExample code={example(framework, 'diffusion')} title="Define and train a DiT" />
			<p class="framework-note">A {modelSize}M-parameter text-to-image model at {resolution}, trained with Dew. Weights: <a href="https://huggingface.co/dewml/hybrid-dit-176m">dewml/hybrid-dit-176m</a>.</p>
			<div class="replay-grid">{replays.map((entry) => <figure class="replay-figure" data-replay={`/hero/replay/${entry.name}/`}>
				<div class="replay-frame" style={`aspect-ratio: ${entry.width} / ${entry.height}`}>
					<img src={`/hero/replay/${entry.name}/final.webp`} width={entry.width} height={entry.height} alt={entry.prompt} loading="lazy" decoding="async" />
					<canvas aria-hidden="true" />
				</div><figcaption>“{entry.prompt}”</figcaption>
			</figure>)}</div>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Serving</h2>
			<p class="band-lede">A <code>TextGeneration</code> task holds the model, its weights and the sampling settings. <code>Server</code> runs many requests through one task in shared batches, and each request keeps its own random key and KV cache.</p>
			<EditableExample code={example(framework, 'serving')} title="Batched decoding" />
			<pre class="shown-output">{records.serving.result.text.join('\n')}</pre>
			<p class="framework-note">Store weights in int8 or fp8:</p>
			<EditableExample code={example(framework, 'formats')} title="Weight-only int8 and fp8" />
			<p class="framework-note">The <a href="/guides/inference/">serving guide</a> covers the paged KV cache, prefix sharing, constrained decoding, and the error each quantized format adds.</p>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Distributed</h2>
			<p class="band-lede">To use more devices, give <code>Trainer</code> a mesh; the objective and data stay as they are. FSDP shards parameters and optimizer state, tensor parallelism splits each layer's weight matrices, and an expert axis puts an MoE's experts on different devices. The devices left over form the data-parallel axis.</p>
			<EditableExample code={example(framework, 'mesh')} title="Four simulated CPU devices" />
			<figure class="mesh-overview">
				<div class="mesh-devices">{mesh.devices.map((id: number, index: number) => <div class="mesh-device"><strong>cpu:{id}</strong><span>fsdp {Math.floor(index / mesh.axes.tensor)} · tensor {index % mesh.axes.tensor}</span></div>)}</div>
				<figcaption>{mesh.devices.length} simulated CPU devices: {mesh.axes.fsdp} FSDP shards × {mesh.axes.tensor} tensor slices.</figcaption>
			</figure>
			<p class="framework-note"><a href="/concepts/distributed/">Placement and sharding</a> · <a href="/guides/multi-node/">Several hosts</a> · <a href="/guides/tpu/">Cloud TPU</a></p>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Post-training</h2>
			<p class="band-lede">GRPO samples a group of completions for each prompt and scores them with a reward function. The reward here is the fraction of adjacent tokens that count up by one, modulo 13.</p>
			<EditableExample code={example(framework, 'grpo')} title="Rollout and reward" />
			<figure class="reward-figure">
				<svg viewBox="0 0 380 180" role="img" aria-label={`Mean completion reward at each of ${reward.length} GRPO updates; fraction of adjacent tokens counting up modulo 13.`}>
					<line x1="40" y1="40" x2="40" y2="140" /><line x1="40" y1="140" x2="340" y2="140" />
					<text x="25" y="45" text-anchor="end">1</text><text x="25" y="145" text-anchor="end">0</text>
					<text x="40" y="165">step 1</text><text x="340" y="165" text-anchor="end">step {reward.at(-1)!.step}</text>
					<polyline points={rewardPoints} />
					{reward.map((row) => <circle cx={40 + (row.step - 1) / Math.max(1, reward.at(-1)!.step - 1) * 300} cy={140 - row.reward * 100} r="2.5" />)}
				</svg>
				<figcaption>Mean reward of the sampled completions at each of {records.grpo.result.steps} updates (<a href="/examples/framework/grpo/tracking/scalars.jsonl">raw log</a>). <a href="/guides/post-training/">SFT, DPO, PPO and Flow-GRPO</a> train with the same <code>Trainer</code>.</figcaption>
			</figure>
		</section>

		<section class="band" data-reveal>
			<h2 class="band-title">Reliability</h2>
			<p class="band-lede">A checkpoint stores the training state and the position in the data stream. When the job receives SIGTERM, <code>fit</code> stops at the next step every process agrees on, writes a checkpoint and exits with status 143. Run the same command again to resume.</p>
			<EditableExample code={example(framework, 'reliability')} title="Save and resume" />
			<pre class="shown-output">{`Saved step ${records.reliability.result.saved_step}, then resumed and trained to step ${records.reliability.result.resumed_step}.\nEvery TrainState leaf matches an uninterrupted run bit for bit: ${records.reliability.result.bit_exact}.`}</pre>
			<EditableExample code={example(framework, 'profile')} title="JAX/XProf capture" />
			<p class="framework-note"><a href="/guides/checkpoints/">Checkpoint guarantees</a> · <a href="/reference/performance/">Profiling</a></p>
		</section>

		<section class="band try" data-reveal>
			<h2 class="band-title">Try the 176M model</h2>
			<ul class="try-list">{tries.map((entry) => <li><a class="try-link" href={entry.href}><span class="try-name">{entry.name}</span><span class="try-what">{entry.what}</span></a></li>)}</ul>
		</section>

		<section class="band tutorials" data-reveal>
			<h2 class="band-title">Tutorials</h2>
			<ol class="tutorial-list">{tutorials.map((entry) => <li><a class="tutorial-link" href={`/${entry.slug}/`}><span class="tutorial-number">{entry.number}</span><span class="tutorial-name">{tutorialNames[entry.number]}</span><span class="tutorial-device">{entry.accelerator}</span></a></li>)}</ol>
		</section>
		<details class="band framework-note">
			<summary>How each example above was recorded</summary>
			<ul>{names.map((name) => {
				const entry = records[name].capture;
				return <li><a href={`/examples/framework/${name}/capture.json`}>{name}</a>: {entry.meta.where}, JAX {entry.meta.jax}, Dew{' '}
					<a href={`https://github.com/AshishKumar4/dew/commit/${entry.meta.dew}`}><code>{entry.meta.dew.slice(0, 7)}</code></a>, {entry.meta.date}, {entry.hero.seconds} s.</li>;
			})}</ul>
		</details>
		<footer class="landing-footer"><span>MIT license. Research software before 1.0.</span><a href={fullScript}>All examples as one script</a><a href="https://github.com/AshishKumar4/dew">GitHub</a></footer>
	</div>
</StarlightPage>

<script>
	import { startReplays } from '../hero/replay-section';
	const videoObserver = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const video = entry.target as HTMLVideoElement;
			if (entry.isIntersecting) {
				if (!video.src) video.src = video.dataset.src!;
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches) void video.play().catch(() => {});
			} else video.pause();
		}
	});
	for (const video of document.querySelectorAll('[data-lazy-video]')) videoObserver.observe(video);
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const replays = document.querySelector<HTMLElement>('[data-replays]');
	if (replays && !still) {
		const near = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			near.disconnect();
			void startReplays(replays);
		}, { rootMargin: '50% 0px' });
		near.observe(replays);
	}
	if (!still) {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-in');
				observer.unobserve(entry.target);
			}
		}, { rootMargin: '0px 0px -12% 0px' });
		document.documentElement.dataset.reveal = '';
		for (const section of document.querySelectorAll<HTMLElement>('[data-reveal]')) observer.observe(section);
	}
</script>
