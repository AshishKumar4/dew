---
// The landing page. The hero comes from components/landing/LandingHero.astro
// (Starlight renders it in the splash template's hero slot). Below it, each
// section shows real code and the output it printed: the page's own script,
// which also runs live, then cells from the tutorials, then the tutorials.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import HeroOutput from '../components/landing/HeroOutput.astro';
import capture from '../data/capture.json';
import heroCode from '../data/hero.py?raw';
import outputs from '../generated/notebook-outputs.json';
import tutorials from '../generated/tutorial-cards.json';
import '../styles/landing.css';

const hero = capture.snippets.hero;
if (hero.returncode !== 0) throw new Error('src/data/capture.json: the hero snippet did not exit cleanly');

// docs/key-concepts.md opens with the same program and quotes its output, so the two
// pages cannot drift apart: its first Python block is hero.py, and the text block
// after it is what capture.json recorded.
{
	const page = readFileSync(path.join(process.cwd(), '..', 'docs', 'key-concepts.md'), 'utf8');
	const program = /```python\n([\s\S]*?)\n```/.exec(page);
	const printed = program && /```text\n([\s\S]*?)\n```/.exec(page.slice(program.index + program[0].length));
	if (program?.[1] !== heroCode.trimEnd()) throw new Error('docs/key-concepts.md: its first Python block differs from src/data/hero.py');
	if (printed?.[1] !== hero.stdout.trimEnd()) {
		throw new Error('docs/key-concepts.md: its output block differs from src/data/capture.json; paste what scripts/capture_snippets.py recorded');
	}
}

// Cells from the tutorials, with what they printed on their last complete run.
const shown = [
	{ label: 'Language models', notebook: '05-train-a-language-model', cell: 'cell-20' },
	{ label: 'Released weights', notebook: '08-load-a-pretrained-decoder', cell: 'cell-21' },
	{ label: 'Meshes', notebook: '07-scaling-on-many-devices', cell: 'cell-16' },
].map((entry) => {
	const record = (outputs as Record<string, Record<string, { source?: string; stdout?: string }>>)[entry.notebook]?.[entry.cell];
	if (!record?.source || !record.stdout) throw new Error(`index.astro: ${entry.notebook} ${entry.cell} has no recorded output`);
	return { ...entry, source: record.source.trimEnd(), stdout: record.stdout.trimEnd() };
});

// Sampling trajectories of a text-to-image model, packed into public/hero/replay/ by scripts/replay-atlas.py.
const replays = ['lake', 'lighthouse', 'fruit'].map((name) => {
	// Read from the project's public/, where the build runs (the page's own module is bundled elsewhere).
	const meta = JSON.parse(readFileSync(path.join(process.cwd(), 'public', 'hero', 'replay', name, 'meta.json'), 'utf8'));
	return { name, prompt: meta.prompt as string, model: meta.model as { model: string; parameters: number } };
});
const replayModel = replays[0].model;
if (!replays.every((replay) => replay.model.model === replayModel.model) || !/^FlaxDiff /.test(replayModel.model)) {
	throw new Error('index.astro: the replays must come from one model trained with FlaxDiff, as the page says');
}
const replayParameters = `${Math.round(replayModel.parameters / 1e6)}M`;

// Short names for the tutorial cards; the tutorials' own titles are on their pages.
const names: Record<string, string> = {
	'01': 'Diffusion from scratch',
	'02': 'Image diffusion',
	'03': 'Text to image',
	'04': 'Samplers',
	'05': 'Language model',
	'06': 'I-JEPA',
	'07': 'Many devices',
	'08': 'Pretrained decoders',
};
const cards = tutorials.map((entry) => {
	const name = names[entry.number];
	if (!name) throw new Error(`index.astro: no card name for tutorial ${entry.number}`);
	return { ...entry, name };
});
---

<StarlightPage
	frontmatter={{
		title: 'Dew: train models with JAX and Flax',
		description:
			'Dew is a JAX and Flax framework for training language models, diffusion models and JEPA encoders, on one device or a mesh of GPUs or TPUs.',
		template: 'splash',
		hero: { title: 'Dew' },
		tableOfContents: false,
		editUrl: false,
		lastUpdated: false,
		pagefind: false,
	}}
	hasSidebar={false}
>
	<div class="landing not-content">
		<section class="band run" data-reveal>
			<h2 class="band-title">Run it</h2>
			<div class="run-grid">
				<Code code={heroCode.trimEnd()} lang="python" title="train.py" />
				<HeroOutput code={heroCode} stdout={hero.stdout} meta={capture.meta} seconds={hero.seconds} />
			</div>
		</section>

		<section class="band replay" aria-label="Text to image" data-reveal data-replays>
			<h3 class="shown-label">
				<a href="/tutorials/03-text-to-image-with-guidance/">Text to image</a>
			</h3>
			<div class="replay-grid">
				{
					replays.map((replay) => (
						<figure class="replay-figure" data-replay={`/hero/replay/${replay.name}`}>
							<div class="replay-frame">
								<img src={`/hero/replay/${replay.name}/final.webp`} width="256" height="256" alt="" loading="lazy" decoding="async" />
								<canvas aria-hidden="true" />
							</div>
							<figcaption>“{replay.prompt}”</figcaption>
						</figure>
					))
				}
			</div>
			<p class="replay-note">A {replayParameters}-parameter model trained with FlaxDiff, sampled with Dew.</p>
		</section>

		<section class="band shown" aria-label="From the tutorials">
			{
				shown.map((entry) => (
					<article class="shown-item" data-reveal>
						<h3 class="shown-label">
							<a href={`/tutorials/${entry.notebook}/`}>{entry.label}</a>
						</h3>
						<div class="shown-grid">
							<Code code={entry.source} lang="python" title={`${entry.notebook}.ipynb`} />
							<pre class="shown-output">{entry.stdout}</pre>
						</div>
					</article>
				))
			}
		</section>

		<section class="band tutorials" data-reveal>
			<h2 class="band-title">Tutorials</h2>
			<ol class="tutorial-list">
				{
					cards.map((entry) => (
						<li>
							<a class="tutorial-link" href={`/${entry.slug}/`}>
								<span class="tutorial-number">{entry.number}</span>
								<span class="tutorial-name">{entry.name}</span>
								<span class="tutorial-device">{entry.accelerator}</span>
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<footer class="landing-footer">
			<span>MIT license. Research software before 1.0.</span>
			<a href="/guides/multi-node/#what-has-and-has-not-been-run">What has been run</a>
			<a href="https://github.com/AshishKumar4/dew">GitHub</a>
		</footer>
	</div>
</StarlightPage>

<script>
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// The replay section's code loads when the section comes near; with reduced motion
	// its figures keep their finished images.
	const replays = document.querySelector<HTMLElement>('[data-replays]');
	if (replays && !still) {
		const near = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				near.disconnect();
				import('../hero/replay-section').then(({ startReplays }) => startReplays(replays));
			},
			{ rootMargin: '50% 0px' },
		);
		near.observe(replays);
	}

	// Sections rise into place as they reach the viewport; with reduced motion they are simply there.
	if (!still) {
		const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-in');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -12% 0px' },
		);
		document.documentElement.dataset.reveal = '';
		for (const section of sections) observer.observe(section);
	}
</script>
