---
// The landing page. The hero comes from components/landing/LandingHero.astro
// (Starlight renders it in the splash template's hero slot). Below it, each
// section shows real code and what it produced: the page's own training script
// and the terminal it ran on, text-to-image samples, places to try the model,
// two examples, a tutorial cell, then the tutorials.
import { readFileSync } from 'node:fs';
import path from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import HeroOutput from '../components/landing/HeroOutput.astro';
import capture from '../data/capture.json';
import heroCode from '../data/hero.py?raw';
import outputs from '../generated/notebook-outputs.json';
import tutorials from '../generated/tutorial-cards.json';
import { live } from '../live.mjs';
import '../styles/landing.css';

const hero = capture.hero;
if (hero.returncode !== 0) throw new Error('src/data/capture.json: the hero script did not exit cleanly');

// Places to run the text-to-image model; the live sampler only when this build has live kernels (src/live.mjs).
const tries = [
	...(live.endpoint && live.turnstileSitekey
		? [{ name: 'Live sampler', what: 'Edit the sampling cell and run it on a live CPU kernel.', href: '/sample/' }]
		: []),
	{
		name: 'Colab notebook',
		what: 'Load the model from the Hub and sample it on a GPU.',
		href: 'https://colab.research.google.com/github/AshishKumar4/dew/blob/main/site/notebooks/sample-text-to-image.ipynb',
	},
	{ name: 'dewml/hybrid-dit-176m', what: 'The weights and model card on the Hugging Face Hub.', href: 'https://huggingface.co/dewml/hybrid-dit-176m' },
];

// A cell from a tutorial, with what it printed on the tutorial's last complete run.
const shown = [
	{
		label: 'Released weights',
		title: 'Tutorial 8: the next token from Dew and from transformers',
		notebook: '08-load-a-pretrained-decoder',
		cell: 'cell-21',
	},
].map((entry) => {
	const record = (outputs as Record<string, Record<string, { source?: string; stdout?: string }>>)[entry.notebook]?.[entry.cell];
	if (!record?.source || !record.stdout) throw new Error(`index.astro: ${entry.notebook} ${entry.cell} has no recorded output`);
	return { ...entry, source: record.source.trimEnd(), stdout: record.stdout.trimEnd() };
});

// What the two examples wrote, under public/examples/ (see examples/sample_text_to_image.py and examples/moe_mesh.py).
const readPublic = (...parts: string[]) => readFileSync(path.join(process.cwd(), 'public', ...parts), 'utf8');
interface Sample {
	file: string;
	prompt: string;
	seed: number;
	sampler: string;
	steps: number;
	guidance: number;
	guidance_interval: [number, number];
}
const sampling = JSON.parse(readPublic('examples', 'sample-text-to-image', 'manifest.json')) as {
	device: string;
	images: Sample[];
};
// One grid per sampler setting (the directory each image sits in): a row per prompt, a column per seed.
const samplerGrids = [...new Set(sampling.images.map((image) => image.file.split('/')[0]))].map((key) => {
	const images = sampling.images.filter((image) => image.file.startsWith(`${key}/`));
	const [first] = images;
	const [from, to] = first.guidance_interval;
	const interval = from === 0 && to === 1 ? '' : `, applied from ${from * 100}% to ${to * 100}% of the way`;
	const prompts = [...new Set(images.map((image) => image.prompt))];
	return {
		key,
		label: `${first.sampler}, ${first.steps} steps`,
		settings: `${first.sampler}, ${first.steps} steps, guidance ${first.guidance}${interval}`,
		rows: prompts.map((prompt) => ({
			prompt,
			images: images.filter((image) => image.prompt === prompt).sort((a, b) => a.seed - b.seed),
		})),
	};
});
const seeds = new Set(sampling.images.map((image) => image.seed)).size;
const moeLog = readPublic('examples', 'moe-mesh', 'moe-mesh.log');
if (!/over 8 cpu device\(s\)/.test(moeLog)) throw new Error('index.astro: the MoE caption says 8 simulated CPU devices; moe-mesh.log says otherwise');

// Sampling trajectories of a text-to-image model, packed into public/hero/replay/ by scripts/replay-atlas.py.
const replays = ['aurora', 'beach', 'lighthouse'].map((name) => {
	// Read from the project's public/, where the build runs (the page's own module is bundled elsewhere).
	const meta = JSON.parse(readFileSync(path.join(process.cwd(), 'public', 'hero', 'replay', name, 'meta.json'), 'utf8'));
	return {
		name,
		prompt: meta.prompt as string,
		width: meta.width as number,
		height: meta.height as number,
		model: meta.model as { model: string; parameters: number; dew_commit: string },
		steps: meta.steps as number,
	};
});
// The note under the figures names one text-to-image model of this size: every
// trajectory's provenance must name the same model and the Dew commit that sampled it.
const replayModel = replays[0].model;
if (!replays.every((replay) => replay.model.model === replayModel.model && /^[0-9a-f]{40}$/.test(replay.model.dew_commit))) {
	throw new Error('index.astro: the replays must come from one model, each sampled with Dew at a recorded commit');
}
const replayParameters = `${Math.round(replayModel.parameters / 1e6)}M`;
const replaySteps = replays[0].steps;

// Short names for the tutorial cards; the tutorials' own titles are on their pages.
const names: Record<string, string> = {
	'01': 'Diffusion from scratch',
	'02': 'Image diffusion',
	'03': 'Text to image',
	'04': 'Samplers',
	'05': 'Language model',
	'06': 'I-JEPA',
	'07': 'Many devices',
	'08': 'Pretrained decoders',
};
const cards = tutorials.map((entry) => {
	const name = names[entry.number];
	if (!name) throw new Error(`index.astro: no card name for tutorial ${entry.number}`);
	return { ...entry, name };
});
---

<StarlightPage
	frontmatter={{
		title: 'Dew: train models with JAX and Flax',
		description:
			'Dew is a JAX and Flax framework for training language models, diffusion models and JEPA encoders, on one device or a mesh of GPUs or TPUs.',
		template: 'splash',
		hero: { title: 'Dew' },
		tableOfContents: false,
		editUrl: false,
		lastUpdated: false,
		pagefind: false,
	}}
	hasSidebar={false}
>
	<div class="landing not-content">
		<section class="band run" data-reveal>
			<h2 class="band-title">A training run</h2>
			<p class="band-lede">
				A byte-level decoder whose every layer routes each token to 2 of 8 experts, trained on Tiny Shakespeare for
				300 steps on a mesh of eight CPU devices simulated in one process, then served on the same mesh. The terminal
				is what this script left on the screen.
			</p>
			<div class="run-grid">
				<Code code={heroCode.trimEnd()} lang="python" title="train.py" />
				<HeroOutput screen={hero.screen} meta={capture.meta} seconds={hero.seconds} />
			</div>
		</section>

		<section class="band replay" aria-label="Text to image" data-reveal data-replays>
			<h3 class="shown-label">
				<a href="/tutorials/03-text-to-image-with-guidance/">Text to image</a>
			</h3>
			<div class="replay-grid">
				{
					replays.map((replay) => (
						<figure class="replay-figure" data-replay={`/hero/replay/${replay.name}`}>
							<div class="replay-frame" style={`aspect-ratio: ${replay.width} / ${replay.height}`}>
								<img src={`/hero/replay/${replay.name}/final.webp`} width={replay.width} height={replay.height} alt="" loading="lazy" decoding="async" />
								<canvas aria-hidden="true" />
							</div>
							<figcaption>“{replay.prompt}”</figcaption>
						</figure>
					))
				}
			</div>
			<p class="replay-note">
				A {replayParameters}-parameter text-to-image model at 256×256, trained with Dew. Each figure replays the
				sampler's prediction of the finished image at every one of its {replaySteps} steps. The weights are{' '}
				<a href="https://huggingface.co/dewml/hybrid-dit-176m">dewml/hybrid-dit-176m</a>.
			</p>
		</section>

		<section class="band try" aria-label="Try the model" data-reveal>
			<h3 class="shown-label">Try it</h3>
			<ul class="try-list">
				{
					tries.map((entry) => (
						<li>
							<a class="try-link" href={entry.href}>
								<span class="try-name">{entry.name}</span>
								<span class="try-what">{entry.what}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="band shown" aria-label="Examples and tutorials">
			<article class="shown-item" data-reveal>
				<h3 class="shown-label">
					<a href="/examples/#sample_text_to_imagepy">Samplers compared</a>
				</h3>
				<figure class="example-figure sampler-figure">
					<div class="sampler-tabs" role="radiogroup" aria-label="Sampler">
						{
							samplerGrids.map((grid, index) => (
								<label>
									<input type="radio" name="sampler" value={grid.key} checked={index === 0} />
									{grid.label}
								</label>
							))
						}
					</div>
					{
						samplerGrids.map((grid, index) => (
							<div class="sampler-grid" data-sampler={grid.key} hidden={index !== 0}>
								{grid.rows.map((row) => (
									<div class="sampler-row">
										<p class="sampler-prompt">“{row.prompt}”</p>
										<div class="sampler-images">
											{row.images.map((image) => (
												<img
													src={`/examples/sample-text-to-image/${image.file}`}
													width="256"
													height="256"
													alt={`Seed ${image.seed}`}
													loading="lazy"
													decoding="async"
												/>
											))}
										</div>
									</div>
								))}
								<p class="sampler-settings">{grid.settings}.</p>
							</div>
						))
					}
					<figcaption>
						<code>examples/sample_text_to_image.py</code> samples the text-to-image model above with each sampler, over
						the same prompts and {seeds} seeds, recorded on an {sampling.device}.
					</figcaption>
				</figure>
			</article>
			<article class="shown-item" data-reveal>
				<h3 class="shown-label">
					<a href="/examples/#moe_meshpy">Mixture of experts on a mesh</a>
				</h3>
				<figure class="example-figure">
					<div class="figure-scroll">
						<img
							src="/examples/moe-mesh/moe-mesh.svg"
							width="1430"
							height="662"
							alt="Eight devices in a data by expert by fsdp grid, with the routed slots each device sends to the others, the slots each expert receives, and the training loss."
							loading="lazy"
							decoding="async"
						/>
					</div>
					<figcaption>
						<code>examples/moe_mesh.py</code> trains an eight-expert, top-2 decoder on a mesh of data 2, expert 2 and
						fsdp 2, here eight CPU devices simulated in one process. Each frame is one training step: the experts its
						batch's tokens pick, and how many routed slots each device sends to the others in the all-to-all. The last
						frame routes the prompts and their greedy continuations after training.
					</figcaption>
				</figure>
			</article>
			{
				shown.map((entry) => (
					<article class="shown-item" data-reveal>
						<h3 class="shown-label">
							<a href={`/tutorials/${entry.notebook}/`}>{entry.label}</a>
						</h3>
						<div class="shown-grid">
							<Code code={entry.source} lang="python" title={entry.title} />
							<pre class="shown-output">{entry.stdout}</pre>
						</div>
					</article>
				))
			}
		</section>

		<section class="band tutorials" data-reveal>
			<h2 class="band-title">Tutorials</h2>
			<ol class="tutorial-list">
				{
					cards.map((entry) => (
						<li>
							<a class="tutorial-link" href={`/${entry.slug}/`}>
								<span class="tutorial-number">{entry.number}</span>
								<span class="tutorial-name">{entry.name}</span>
								<span class="tutorial-device">{entry.accelerator}</span>
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<footer class="landing-footer">
			<span>MIT license. Research software before 1.0.</span>
			<a href="/guides/multi-node/#what-has-and-has-not-been-run">What has been run</a>
			<a href="https://github.com/AshishKumar4/dew">GitHub</a>
		</footer>
	</div>
</StarlightPage>

<script>
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// The sampler buttons show one grid at a time; without this script the first one shows.
	for (const figure of document.querySelectorAll<HTMLElement>('.sampler-figure')) {
		figure.addEventListener('change', (event) => {
			const chosen = (event.target as HTMLInputElement).value;
			for (const grid of figure.querySelectorAll<HTMLElement>('[data-sampler]')) grid.hidden = grid.dataset.sampler !== chosen;
		});
	}

	// The replay section's code loads when the section comes near; with reduced motion
	// its figures keep their finished images.
	const replays = document.querySelector<HTMLElement>('[data-replays]');
	if (replays && !still) {
		const near = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				near.disconnect();
				import('../hero/replay-section').then(({ startReplays }) => startReplays(replays));
			},
			{ rootMargin: '50% 0px' },
		);
		near.observe(replays);
	}

	// Sections rise into place as they reach the viewport; with reduced motion they are simply there.
	if (!still) {
		const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-in');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -12% 0px' },
		);
		document.documentElement.dataset.reveal = '';
		for (const section of sections) observer.observe(section);
	}
</script>
