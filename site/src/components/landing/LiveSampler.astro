---
// The live cell calls the shared native Dew model through its lightweight client.
// The folded example runs directly in a reader's own Dew environment.
//
// The figure beside the editor keeps its size through a run: a status line and
// a bar say which stage the run is in (the bot check, the kernel starting and
// loading the model, each sampler step, the decode), each step's preview replaces
// the last, and the finished image fades in over them. The kernel reports a
// step as a display output whose text is {"dew-progress": {"step": k,
// "steps": n}} with a small PNG preview, and the decode as {"dew-progress":
// {"stage": "decode"}}; any other image is the cell's result.
import EditableExample from './EditableExample.astro';
import PythonEditor from './PythonEditor.astro';
import { live } from '../../live.mjs';

interface Props {
	setup: string;
	cell: string;
	colab: string;
}
const { setup, cell, colab } = Astro.props;
const liveEnabled = Boolean(live.endpoint && live.turnstileSitekey);
const native = `${setup.trimEnd()}\n\n${cell.replace('from model_client import CFG, DPMSolverMultistep, from_pretrained\n\n', '').trimEnd()}`
	.replace(/result\.pil\(\)\[0\]$/, 'result.pil()[0].save("dew-sample.png")');
---

<div class="live-sampler" data-live-sampler>
	<div class="sampler-code">
		<div class="sampler-editor">
			<div class="sampler-editor-bar">
				<span>sample.py, editable</span>
				<span class="sampler-editor-actions">
					<button type="button" class="sampler-reset" data-reset>Reset</button>
					{
						liveEnabled && (
							<button type="button" class="sampler-run" data-run>
								Run
							</button>
						)
					}
				</span>
			</div>
			<PythonEditor code={cell.trimEnd()} kind="image" rows={cell.trimEnd().split('\n').length + 1} label="The sampling cell" />
		</div>
		<details class="sampler-setup">
			<summary>Native Dew sampler for your own environment</summary>
			<EditableExample code={native} title="Native text-to-image sampler" />
		</details>
		<p class="framework-note">Run live uses the shared Dew model through a lightweight Python client. The native example above runs with Dew installed in your own environment.</p>
	</div>

	<figure class="sampler-stage" data-stage="idle">
		<div class="sampler-frame">
			<img data-preview alt="" hidden />
			<img data-final alt="" hidden />
			<p class="sampler-frame-empty" data-empty>
				{liveEnabled ? 'The image appears here.' : 'Live kernels are not set up for this build of the site.'}
			</p>
		</div>
		<div class="sampler-bar" data-bar aria-hidden="true"><span></span></div>
		<figcaption>
			<p class="sampler-status" data-status aria-live="polite">
				{liveEnabled && 'Run opens an isolated Python context backed by the shared Dew model on a 4-vCPU CPU host.'}
			</p>
			<p class="sampler-detail" data-detail></p>
		</figcaption>
	</figure>

	<details class="sampler-log" data-log hidden>
		<summary>Kernel output</summary>
		<div data-output></div>
	</details>
	<p class="sampler-colab">
		Or <a href={colab} target="_blank" rel="noopener">open it in Colab</a> to run it on a GPU and change anything.
	</p>
	<div class="turnstile-holder" data-turnstile></div>
</div>

<script>
	import type { LiveSession, Output } from '../../scripts/live';
	import { renderOutput } from '../../scripts/live';
	import { landingKernel, reserveKernel, onKernelClose, closeKernel } from '../../scripts/landing-kernel';

	const panel = document.querySelector<HTMLElement>('[data-live-sampler]');
	const run = panel?.querySelector<HTMLButtonElement>('[data-run]');
	if (panel && run) {
		const q = <T extends HTMLElement>(selector: string) => panel.querySelector<T>(selector)!;
		const editor = q<HTMLTextAreaElement>('textarea[data-cell]');
		const stage = q<HTMLElement>('.sampler-stage');
		const preview = q<HTMLImageElement>('[data-preview]');
		const final = q<HTMLImageElement>('[data-final]');
		const empty = q<HTMLElement>('[data-empty]');
		const bar = q<HTMLElement>('[data-bar] span');
		const status = q<HTMLElement>('[data-status]');
		const detail = q<HTMLElement>('[data-detail]');
		const log = q<HTMLDetailsElement>('[data-log]');
		const output = q<HTMLElement>('[data-output]');
		const holder = q<HTMLElement>('[data-turnstile]');
		const original = editor.value;

		let session: LiveSession | undefined;
		let compiled = false;
		let running = false;
		let stopping = false;
		let failure: string | undefined;
		let started = 0;
		let ticker: number | undefined;
		onKernelClose((message) => {
			session = undefined;
			if (!running) show('idle', `${message} Press Run to start a new one.`);
		});

		/** Enter a stage: its name styles the figure, `text` is the status line, `fraction` fills the bar (none: indeterminate). */
		const show = (name: string, text: string, fraction?: number) => {
			stage.dataset.stage = name;
			status.textContent = text;
			stage.style.setProperty('--progress', fraction === undefined ? '' : String(fraction));
			bar.parentElement!.dataset.determinate = fraction === undefined ? 'false' : 'true';
		};
		/** Count the seconds of a wait next to its status line. */
		const tick = (text: string) => {
			window.clearInterval(ticker);
			const since = performance.now();
			const update = () => (detail.textContent = `${text} ${Math.round((performance.now() - since) / 1000)} s`);
			update();
			ticker = window.setInterval(update, 1000);
		};
		const untick = () => {
			window.clearInterval(ticker);
			detail.textContent = '';
		};
		const seconds = () => ((performance.now() - started) / 1000).toFixed(1);
		const image = (png: string) => `data:image/png;base64,${png}`;

		const onOutput = (message: Output) => {
			if (message.type === 'display') {
				let report: { step?: number; steps?: number; stage?: string } | undefined;
				try {
					report = message.text ? JSON.parse(message.text)['dew-progress'] : undefined;
				} catch {
					report = undefined;
				}
				if (report?.step !== undefined && report.steps) {
					untick();
					compiled = true;
					show('sampling', `Step ${report.step} of ${report.steps}`, report.step / report.steps);
					if (message.png) {
						preview.src = image(message.png);
						preview.hidden = false;
						final.hidden = true;
						empty.hidden = true;
					}
					return;
				}
				if (report?.stage === 'decode') {
					show('decoding', 'Decoding the latent into pixels', 1);
					return;
				}
				if (message.png) {
					final.src = image(message.png);
					final.alt = 'The image the cell returned.';
					final.hidden = false;
					empty.hidden = true;
					return;
				}
			}
			if (stopping) return;
			if (message.type === 'error' && message.ename === 'StalePage') {
				failure = message.evalue;
				return;
			}
			if (message.type === 'error') log.open = true;
			if (message.type !== 'clear') log.hidden = false;
			renderOutput(output, message);
		};

		const execute = async () => {
			let release: () => void;
			try {
				release = reserveKernel();
			} catch (error) {
				show('error', error instanceof Error ? error.message : String(error));
				return;
			}
			running = true;
			stopping = false;
			failure = undefined;
			run.textContent = 'Stop';
			output.replaceChildren();
			log.hidden = true;
			log.open = false;
			// On a phone the figure sits below the editor; bring it into view for the run.
			if (stage.getBoundingClientRect().bottom > window.innerHeight) stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
			try {
				if (!session) {
					show('starting', 'Checking that you are not a bot');
					tick('Waiting');
					const opened = await landingKernel(holder, (text) => show('starting', text.replace(/…$/, '')));
					if (stopping) {
						closeKernel();
						throw new Error('Stopped.');
					}
					session = opened;
					compiled = opened.warm;
				}
				started = performance.now();
				// A cold kernel compiles the sampler before its first step (about 15 s on the preview's 4 vCPUs);
				// a warm spare compiled it before it was handed out.
				show('sampling', compiled ? 'Sampling' : 'Starting the sampler; a new kernel compiles it first');
				tick('Running');
				const done = await session.run(editor.value, onOutput);
				untick();
				if (stopping || done.status === 'aborted') show('idle', 'Stopped.');
				else if (done.status === 'ok') show('done', `The cell ran in ${seconds()} s on the live kernel.`, 1);
				else show('error', failure ?? 'The cell stopped with an error; the kernel output below says why.');
			} catch (error) {
				untick();
				closeKernel();
				session = undefined;
				show(stopping ? 'idle' : 'error', stopping ? 'Stopped.' : error instanceof Error ? error.message : String(error));
			} finally {
				release();
				running = false;
				run.textContent = 'Run';
				run.disabled = false;
			}
		};

		// Stopping interrupts the cell; before the kernel is ready it lets the start finish and closes it.
		const stop = () => {
			stopping = true;
			run.disabled = true;
			show(stage.dataset.stage ?? 'idle', 'Stopping');
			session?.interrupt();
		};

		q<HTMLButtonElement>('[data-reset]').addEventListener('click', () => (editor.value = original));
		run.addEventListener('click', () => (running ? stop() : void execute()));
		editor.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' && (event.ctrlKey || event.metaKey) && !running) {
				event.preventDefault();
				void execute();
			}
		});
	}
</script>
