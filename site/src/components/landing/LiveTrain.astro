---
// An editable training cell that Run trains on the live host, in a training
// context running Dew itself (site/live/container/live_training.py). The host
// runs one at a time: while a run waits, the bridge reports how many are ahead
// as a display output {"dew-wait": {"ahead": n}}.
import PythonEditor from './PythonEditor.astro';
import { live } from '../../live.mjs';

interface Props {
	code: string;
	title: string;
	cell: string;
}
const { code, title, cell } = Astro.props;
const liveEnabled = Boolean(live.endpoint && live.turnstileSitekey);
---
<div class="live-train" data-live-train={cell}>
	<div class="sampler-editor">
		<div class="sampler-editor-bar">
			<span>{title}, editable</span>
			<span class="sampler-editor-actions">
				<button type="button" data-train-copy>Copy</button>
				<button type="button" data-train-reset>Reset</button>
				{liveEnabled && <button type="button" class="sampler-run" data-train-run>Run</button>}
			</span>
		</div>
		<PythonEditor code={code.trimEnd()} kind="example" rows={Math.min(20, code.trimEnd().split('\n').length + 1)} label={title} />
	</div>
	<div class="live-text-output" data-train-output hidden></div>
	{liveEnabled && <p class="sampler-status" data-train-status aria-live="polite">Run trains it on a shared 4-vCPU host, for at most 20 steps.</p>}
	<div class="turnstile-holder" data-train-turnstile></div>
</div>

<script>
	import type { LiveSession } from '../../scripts/live';
	import { renderOutput } from '../../scripts/live';
	import { landingKernel, onKernelClose } from '../../scripts/landing-kernel';

	for (const panel of document.querySelectorAll<HTMLElement>('[data-live-train]')) {
		const cell = panel.dataset.liveTrain!;
		const editor = panel.querySelector<HTMLTextAreaElement>('textarea')!;
		const copy = panel.querySelector<HTMLButtonElement>('[data-train-copy]')!;
		const run = panel.querySelector<HTMLButtonElement>('[data-train-run]');
		const output = panel.querySelector<HTMLElement>('[data-train-output]')!;
		const status = panel.querySelector<HTMLElement>('[data-train-status]');
		const holder = panel.querySelector<HTMLElement>('[data-train-turnstile]')!;
		copy.addEventListener('click', async () => {
			await navigator.clipboard.writeText(editor.value).catch(() => editor.select());
			copy.textContent = 'Copied';
			setTimeout(() => { copy.textContent = 'Copy'; }, 1500);
		});
		panel.querySelector('[data-train-reset]')!.addEventListener('click', () => {
			editor.value = editor.defaultValue;
			editor.dispatchEvent(new Event('input'));
		});
		if (!run || !status) continue;
		let session: LiveSession | undefined;
		let running = false;
		let stopping = false;
		onKernelClose((message) => {
			session = undefined;
			if (!running) status.textContent = `${message} Press Run to start a new one.`;
		});
		const execute = async () => {
			running = true;
			stopping = false;
			run.textContent = 'Stop';
			output.replaceChildren();
			output.hidden = false;
			let phase = 'Starting';
			let since = performance.now();
			const setPhase = (text: string) => {
				phase = text;
				since = performance.now();
				status.textContent = text;
			};
			const timer = window.setInterval(() => {
				if (!stopping) status.textContent = `${phase} · ${Math.round((performance.now() - since) / 1000)} s`;
			}, 1000);
			try {
				session = await landingKernel(holder, setPhase);
				if (stopping) throw new Error('Stopped.');
				const started = performance.now();
				setPhase('Training');
				const result = await session.run(editor.value, (message) => {
					if (message.type === 'display' && message.text?.startsWith('{"dew-wait"')) {
						const { ahead } = JSON.parse(message.text)['dew-wait'];
						setPhase(`This host trains one run at a time; ${ahead} ${ahead === 1 ? 'run is' : 'runs are'} ahead of yours`);
						return;
					}
					if (phase !== 'Training') setPhase('Training');
					renderOutput(output, message);
				}, cell, 'train');
				status.textContent = stopping || result.status === 'aborted' ? 'Stopped.'
					: result.status === 'ok' ? `Ran in ${((performance.now() - started) / 1000).toFixed(0)} s on a shared 4-vCPU host.`
					: 'The cell stopped with an error.';
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : String(error);
			} finally {
				window.clearInterval(timer);
				running = false;
				run.textContent = 'Run';
				run.disabled = false;
			}
		};
		run.addEventListener('click', () => {
			if (!running) void execute();
			else { stopping = true; run.disabled = true; status.textContent = 'Stopping'; session?.interrupt(cell); }
		});
	}
</script>

<style>
	.live-train { display: grid; gap: 0.65rem; min-width: 0; }
	.live-train .live-text-output { min-height: 0; max-height: 24rem; overflow: auto; }
	.live-train .sampler-editor-bar { flex-wrap: wrap; }
</style>
