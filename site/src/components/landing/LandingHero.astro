---
// The hero: the headline, one line, the install command and three links, over
// a full-screen shader that src/hero/hero.ts picks after the first paint.
// data-particles names the particle model trained on this font's letters.
import CopyCommand from './CopyCommand.astro';

const install = 'uv pip install "dew-ml @ git+https://github.com/AshishKumar4/dew"';
---

<section class="hero" data-hero data-particles="geist">
	<div class="hero-stage" aria-hidden="true">
		<div class="hero-still"></div>
		<canvas></canvas>
	</div>
	<div class="hero-copy">
		<h1 id="_top">Train models with JAX and&nbsp;Flax.</h1>
		<p class="hero-lede">Language models, diffusion and JEPA, on one device or a mesh.</p>
		<CopyCommand command={install} />
		<nav class="hero-links" aria-label="Start here">
			<a class="button primary" href="/getting-started/quickstart/">Get started</a>
			<a class="button" href="/tutorials/">Tutorials</a>
			<a class="button ghost" href="/api/">API reference</a>
		</nav>
	</div>
</section>

<script>
	import { startHero } from '../../hero/hero';

	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero) {
		void startHero(hero);
		// The header is clear over the hero and solid below it.
		const root = document.documentElement;
		const onScroll = () => root.toggleAttribute('data-past-hero', scrollY > hero.offsetHeight - 72);
		addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}
</script>
