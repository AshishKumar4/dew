---
import PythonEditor from './PythonEditor.astro';
import { live } from '../../live.mjs';
interface Props {
	cell: string;
	// What the cell printed when site/scripts/capture_snippets.py ran it.
	recording: { text: string; meta: { where: string; dew: string; date: string }; seconds: number };
}
const { cell, recording } = Astro.props;
const liveEnabled = Boolean(live.endpoint && live.turnstileSitekey);
---

<div class="live-text" data-live-text>
	<div class="live-text-grid">
		<div class="sampler-editor">
			<div class="sampler-editor-bar"><span>generate.py</span><span class="sampler-editor-actions">
				{liveEnabled && <button type="button" class="sampler-run" data-text-run>Run</button>}
			</span></div>
			<PythonEditor code={cell} kind="text" rows={cell.trimEnd().split('\n').length + 1} label="Editable text generation cell" />
		</div>
		<div class="live-text-result">
			<div class="live-text-output" data-text-output><pre>{recording.text}</pre></div>
			<p class="sampler-status" data-text-status aria-live="polite">Recorded on {recording.meta.where} with Dew <a href={`https://github.com/AshishKumar4/dew/commit/${recording.meta.dew}`}><code>{recording.meta.dew.slice(0, 7)}</code></a> on {recording.meta.date}, in {Math.round(recording.seconds)} s.{liveEnabled && ' Run the cell on a live CPU kernel.'}</p>
		</div>
	</div>
	<div class="turnstile-holder" data-text-turnstile></div>
</div>

<script>
	import type { LiveSession } from '../../scripts/live';
	import { renderOutput } from '../../scripts/live';
	import { landingKernel, onKernelClose } from '../../scripts/landing-kernel';

	const panel = document.querySelector<HTMLElement>('[data-live-text]');
	if (panel?.querySelector('[data-text-run]')) {
		const editor = panel.querySelector<HTMLTextAreaElement>('textarea[data-text-cell]')!;
		const run = panel.querySelector<HTMLButtonElement>('[data-text-run]')!;
		const output = panel.querySelector<HTMLElement>('[data-text-output]')!;
		const status = panel.querySelector<HTMLElement>('[data-text-status]')!;
		const holder = panel.querySelector<HTMLElement>('[data-text-turnstile]')!;
		let session: LiveSession | undefined;
		let running = false;
		let stopping = false;
		onKernelClose((message) => {
			session = undefined;
			if (!running) status.textContent = `${message} Press Run to start a new one.`;
		});
		const execute = async () => {
			running = true;
			stopping = false;
			run.textContent = 'Stop';
			output.replaceChildren();
			if (output.getBoundingClientRect().bottom > innerHeight) output.scrollIntoView({ block: 'center', behavior: 'smooth' });
			let timer: number | undefined;
			let phase = 'Starting';
			let since = performance.now();
			const setPhase = (text: string) => {
				phase = text;
				since = performance.now();
				status.textContent = text;
			};
			try {
				timer = window.setInterval(() => { if (!stopping) status.textContent = `${phase} · ${Math.round((performance.now() - since) / 1000)} s`; }, 1000);
				session = await landingKernel(holder, setPhase);
				if (stopping) throw new Error('Stopped.');
				const started = performance.now();
				setPhase('Generating');
				// The server streams the text so far; the cell then prints all of it, which is already shown.
				const streamed = document.createElement('pre');
				let first: number | undefined;
				const result = await session.run(editor.value, (message) => {
					if (message.type === 'display' && message.text?.startsWith('{"dew-text"')) {
						const packet = JSON.parse(message.text);
						first ??= packet.first_token_seconds;
						streamed.textContent = packet['dew-text'];
						if (!streamed.isConnected) output.append(streamed);
						return;
					}
					if (message.type === 'stream' && message.text.trimEnd() === streamed.textContent?.trimEnd()) return;
					renderOutput(output, message);
				}, 'text');
				window.clearInterval(timer);
				const seconds = ((performance.now() - started) / 1000).toFixed(1);
				status.textContent = stopping || result.status === 'aborted' ? 'Stopped.'
					: result.status !== 'ok' ? 'The cell stopped with an error.'
					: first === undefined ? `Generated in ${seconds} s.`
					: `Generated in ${seconds} s; the first token came ${first.toFixed(2)} s after the request.`;
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : String(error);
			} finally {
				window.clearInterval(timer);
				running = false;
				run.textContent = 'Run';
				run.disabled = false;
			}
		};
		run.addEventListener('click', () => {
			if (!running) void execute();
			else { stopping = true; run.disabled = true; status.textContent = 'Stopping'; session?.interrupt('text'); }
		});
		editor.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' && (event.ctrlKey || event.metaKey) && !running) {
				event.preventDefault();
				void execute();
			}
		});
	}
</script>
