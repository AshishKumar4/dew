---
// The recorded output of the landing page's script and where it was recorded.
interface Props {
	stdout: string;
	seconds: number;
	meta: { where: string; device: string; jax: string; dew: string; date: string };
}
const { stdout, seconds, meta } = Astro.props;
---

<div class="hero-output">
	<div class="hero-output-bar">
		<span class="hero-output-command"><span aria-hidden="true">$</span> python train.py</span>
	</div>
	<pre class="hero-output-text">{stdout.trimEnd()}</pre>
	<p class="hero-output-meta">
		Recorded on {meta.where} ({meta.device}), JAX {meta.jax}, Dew{' '}
		<a href={`https://github.com/AshishKumar4/dew/commit/${meta.dew}`}><code>{meta.dew.slice(0, 7)}</code></a>, {meta.date},{' '}
		{Math.round(seconds)} s from start to end.
	</p>
</div>
