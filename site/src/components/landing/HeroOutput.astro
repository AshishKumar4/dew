---
// The screen the landing page's script left on the terminal it ran on, as
// site/scripts/capture_snippets.py recorded it: rows of runs of text, each
// with the colour, weight and faintness the terminal drew it in.
interface Run {
	text: string;
	fg?: string;
	bold?: boolean;
	dim?: boolean;
}
interface Props {
	screen: Run[][];
	seconds: number;
	meta: { where: string; jax: string; dew: string; date: string };
}
const { screen, seconds, meta } = Astro.props;

// pyte names the eight ANSI colours (yellow as "brown") and gives any other
// colour as hex. The named ones take the site's palette, so they read in either
// theme; a hex colour is drawn as the terminal drew it.
const named: Record<string, string> = {
	black: 'black', red: 'red', green: 'green', brown: 'yellow', blue: 'blue', magenta: 'magenta', cyan: 'cyan', white: 'white',
};
const attributes = (run: Run) => {
	const name = run.fg && named[run.fg];
	return {
		class: [name && `t-${name}`, run.bold && 't-bold', run.dim && 't-dim'].filter(Boolean).join(' ') || undefined,
		style: run.fg && !name ? `color: #${run.fg}` : undefined,
	};
};
---

<div class="hero-output">
	<div class="hero-output-bar">
		<span class="hero-output-command"><span aria-hidden="true">$</span> python train.py</span>
	</div>
	<pre class="hero-output-text">{
		screen.map((row) => [...row.map((run) => (run.fg || run.bold || run.dim ? <span {...attributes(run)}>{run.text}</span> : run.text)), '\n'])
	}</pre>
	<p class="hero-output-meta">
		Recorded on {meta.where}, JAX {meta.jax}, Dew{' '}
		<a href={`https://github.com/AshishKumar4/dew/commit/${meta.dew}`}><code>{meta.dew.slice(0, 7)}</code></a>, {meta.date},{' '}
		{Math.round(seconds)} s from start to end.
	</p>
</div>
