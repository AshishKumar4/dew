---
// Links for a tutorial notebook: Colab, source and download, and for notebooks
// that run on a CPU, a live kernel whose Run buttons appear on each cell.
import { Icon } from '@astrojs/starlight/components';

interface Props {
	notebook: {
		source: string;
		colab: string;
		github: string;
		download: string;
		accelerator: 'CPU' | 'GPU';
		live: boolean;
	};
}

const { notebook } = Astro.props;
const liveConfigured = Boolean(import.meta.env.PUBLIC_LIVE_ENDPOINT && import.meta.env.PUBLIC_TURNSTILE_SITEKEY);
const runtime = notebook.accelerator === 'GPU' ? 'Needs one NVIDIA GPU' : 'Runs on a CPU';
---

<div class="notebook-bar not-content" data-notebook={notebook.source}>
	<a class="nb-button primary" href={notebook.colab} target="_blank" rel="noopener">
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="colab">
			<path fill="#F9AB00" d="M4.5 8.1a4.9 4.9 0 0 0 0 7.8l1.7-1.7a2.5 2.5 0 0 1 0-4.4zm15 0-1.7 1.7a2.5 2.5 0 0 1 0 4.4l1.7 1.7a4.9 4.9 0 0 0 0-7.8z"></path>
			<path fill="#E8710A" d="M12 7.1a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8zm0 2.4a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z"></path>
		</svg>
		Open in Colab
	</a>
	{
		notebook.live && liveConfigured && (
			<button class="nb-button live" type="button" data-live-start>
				<span class="dot" aria-hidden="true" />
				<span data-label>Run live</span>
			</button>
		)
	}
	<a class="nb-button" href={notebook.github} target="_blank" rel="noopener">
		<Icon name="github" size="1rem" />
		View on GitHub
	</a>
	<a class="nb-button" href={notebook.download} download>
		<Icon name="download" size="1rem" />
		Download
	</a>
	<span class="runtime" title={runtime}>{notebook.accelerator}</span>
	{
		notebook.live && liveConfigured && (
			<div class="live-bar" data-live-bar hidden>
				<p class="live-status" data-live-status aria-live="polite" />
				<div class="live-actions" data-live-actions hidden>
					<button class="nb-button" type="button" data-live-all>
						Run all
					</button>
					<button class="nb-button" type="button" data-live-interrupt>
						Interrupt
					</button>
					<button class="nb-button" type="button" data-live-restart>
						Restart
					</button>
				</div>
				<div class="turnstile-holder" data-turnstile />
			</div>
		)
	}
</div>

<script>
	import { type LiveSession as Session, LiveSession, renderOutput } from '../scripts/live';

	const bar = document.querySelector<HTMLElement>('.notebook-bar');
	const start = bar?.querySelector<HTMLButtonElement>('[data-live-start]');
	const source = document.querySelector<HTMLScriptElement>('script[data-notebook-cells]');
	if (bar && start && source) {
		const cells: { id: number; code: string }[] = JSON.parse(source.textContent ?? '[]');
		const liveBar = bar.querySelector<HTMLElement>('[data-live-bar]')!;
		const status = bar.querySelector<HTMLElement>('[data-live-status]')!;
		const actions = bar.querySelector<HTMLElement>('[data-live-actions]')!;
		const label = start.querySelector<HTMLElement>('[data-label]')!;
		let session: Session | undefined;
		let queue: Promise<unknown> = Promise.resolve();

		const say = (text: string) => (status.textContent = text);

		async function runCell(id: number): Promise<boolean> {
			const cell = cells.find((entry) => entry.id === id);
			const block = document.querySelector<HTMLElement>(`.nb-cell[data-cell="${id}"]`);
			if (!session || !cell || !block) return false;
			const button = block.querySelector<HTMLButtonElement>('.nb-run');
			let output = block.querySelector<HTMLElement>('.nb-live');
			if (!output) {
				output = document.createElement('div');
				output.className = 'nb-live';
				block.querySelector('.expressive-code')?.after(output);
			}
			const body = document.createElement('div');
			body.className = 'nb-live-body';
			const head = document.createElement('div');
			head.className = 'nb-live-head';
			head.textContent = 'Running…';
			output.replaceChildren(head, body);
			block.classList.add('nb-ran-live');
			if (button) button.disabled = true;
			const done = await session.run(cell.code, (out) => renderOutput(body, out));
			head.textContent =
				done.status === 'ok' ? `Live [${done.count ?? ' '}]` : done.status === 'error' ? `Live [${done.count ?? ' '}], raised an error` : 'Stopped';
			if (button) button.disabled = false;
			return done.status === 'ok';
		}

		function enqueue(id: number): Promise<boolean> {
			const run = queue.then(() => runCell(id));
			queue = run.catch(() => false);
			return run;
		}

		function addRunButtons(): void {
			for (const cell of cells) {
				const block = document.querySelector<HTMLElement>(`.nb-cell[data-cell="${cell.id}"]`);
				if (!block || block.querySelector('.nb-run')) continue;
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'nb-run';
				button.textContent = 'Run';
				button.setAttribute('aria-label', `Run cell ${cell.id} on the live kernel`);
				button.addEventListener('click', () => enqueue(cell.id));
				block.prepend(button);
			}
		}

		start.addEventListener('click', async () => {
			if (session) return;
			start.disabled = true;
			liveBar.hidden = false;
			try {
				session = await LiveSession.open(liveBar.querySelector('[data-turnstile]')!, say);
				session.onClose = (message) => {
					say(`${message} Press Run live to start a new one.`);
					session = undefined;
					actions.hidden = true;
					start.disabled = false;
					label.textContent = 'Run live';
					for (const button of document.querySelectorAll<HTMLButtonElement>('.nb-run')) button.remove();
				};
				say('Connected to a live kernel: one vCPU and JAX on the CPU, with no network access. It stops after 5 idle minutes or 20 minutes in all. Run the cells in order.');
				label.textContent = 'Live';
				actions.hidden = false;
				addRunButtons();
			} catch (error) {
				say(error instanceof Error ? error.message : String(error));
				start.disabled = false;
			}
		});

		bar.querySelector('[data-live-all]')!.addEventListener('click', async () => {
			for (const cell of cells) {
				if (!(await enqueue(cell.id))) break;
			}
		});
		bar.querySelector('[data-live-interrupt]')!.addEventListener('click', () => session?.interrupt());
		bar.querySelector('[data-live-restart]')!.addEventListener('click', () => {
			session?.restart();
			say('Restarted the kernel. Run the cells again from the top.');
		});
		addEventListener('pagehide', () => session?.close());
	}
</script>

<style>
	.notebook-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--dew-rule);
	}

	.nb-button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 2.1rem;
		padding: 0 0.8rem;
		border-radius: 0.45rem;
		border: 1px solid var(--dew-rule);
		background: var(--dew-surface);
		color: var(--sl-color-white);
		font: 500 0.8125rem/1 var(--__sl-font);
		text-decoration: none;
		cursor: pointer;
	}

	.nb-button:hover {
		border-color: var(--sl-color-gray-4);
	}

	.nb-button:disabled {
		cursor: default;
		opacity: 0.7;
	}

	.nb-button.primary {
		border-color: color-mix(in srgb, var(--dew-accent-fill) 60%, var(--dew-rule));
	}

	.live .dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--dew-accent-fill);
		box-shadow: 0 0 0 3px var(--dew-glow);
	}

	.runtime {
		margin-inline-start: auto;
		font: 600 0.6875rem/1 var(--__sl-font-mono);
		letter-spacing: 0.06em;
		color: var(--dew-muted);
		border: 1px solid var(--dew-rule);
		border-radius: 999px;
		padding: 0.35rem 0.6rem;
	}

	.live-bar {
		flex-basis: 100%;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--dew-accent-fill) 45%, var(--dew-rule));
		border-radius: 0.5rem;
		background: var(--dew-surface);
	}

	.live-bar[hidden] {
		display: none;
	}

	.live-status {
		flex: 1 1 20rem;
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	.live-actions {
		display: flex;
		gap: 0.4rem;
	}

	.live-actions[hidden] {
		display: none;
	}
</style>
