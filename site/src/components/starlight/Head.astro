---
// Starlight's head, plus the site's font families. The text face is
// preloaded; the mono face loads when a page uses it, behind a size-adjusted
// fallback that keeps the layout still.
import Default from '@astrojs/starlight/components/Head.astro';
import { Font } from 'astro:assets';
---

<Default />
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-geist-mono" />
