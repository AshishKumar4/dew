// live.dewml.dev: the "Run live" buttons on dewml.dev. The Worker checks the
// visitor with Turnstile, the Coordinator enforces the limits below, and each
// session gets its own Kernel container. Deploy with `pnpm live:deploy`, which
// pins the container to one Dew commit; see deploy.mjs.
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "dewml-live",
	"account_id": "f44999d1ddda7012e9a87729eba250f1",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-20",
	"routes": [{ "pattern": "live.dewml.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"containers": [
		{
			"class_name": "Kernel",
			"image": "./container/Dockerfile",
			// 4 vCPUs and 12 GiB: the landing page's 176M text-to-image model samples on the CPU.
			"instance_type": "standard-4",
			// MAX_SESSIONS caps what runs; the headroom is for instances the platform still
			// holds, such as one of the previous version during a rollout, which otherwise
			// leave a session or its spare with no container.
			"max_instances": 10,
			// A deploy replaces a running container only after its session could have
			// reached the wall clock (a spare's WARM_SECONDS 600 and WALL_SECONDS 1200,
			// plus the Kernel's 15 s alarm).
			"rollout_active_grace_period": 1815
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "KERNEL", "class_name": "Kernel" },
			{ "name": "COORDINATOR", "class_name": "Coordinator" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kernel", "Coordinator"] }],
	// Requests to the API per visitor IP; sessions have their own limits below.
	"ratelimits": [{ "name": "REQUESTS", "namespace_id": "7401", "simple": { "limit": 30, "period": 60 } }],
	"vars": {
		// Space-separated. preview.dewml.dev uses the preview Worker below.
		"ALLOWED_ORIGINS": "https://dewml.dev",
		"TURNSTILE_HOSTNAMES": "dewml.dev",
		// Whether a token from Cloudflare's always-pass test sitekey counts; only the preview Worker takes them.
		"TURNSTILE_TEST_KEYS": "refuse",
		// Session-seconds a UTC day may use; 40 hours caps the monthly bill.
		"BUDGET_SECONDS": "144000",
		"MAX_SESSIONS": "8",
		"WALL_SECONDS": "1200",
		// How long a spare container waits for the next session: it costs about $0.02 a
		// window idle (12 GiB and 20 GB provisioned), plus about 4 vCPU-minutes to load
		// and compile, and counts against the budget.
		"WARM_SECONDS": "600",
		"IDLE_SECONDS": "300",
		"CPU_SECONDS": "900",
		"IP_WINDOW_SECONDS": "600",
		"IP_STARTS": "3"
	},
	"observability": { "enabled": true },
	"env": {
		// live-preview.dewml.dev, which preview.dewml.dev uses: the same Worker and image, but
		// with Turnstile's test secret, so a headless browser can run the page end to end.
		// Anyone can pass its check, so its budget and session count are small. Deploy with
		// `pnpm live:deploy <sha> -- --env preview`.
		"preview": {
			"name": "dewml-live-preview",
			"routes": [{ "pattern": "live-preview.dewml.dev", "custom_domain": true }],
			"containers": [
				{
					"class_name": "Kernel",
					"image": "./container/Dockerfile",
					"instance_type": "standard-4",
					"max_instances": 4,
					"rollout_active_grace_period": 1815
				}
			],
			"durable_objects": {
				"bindings": [
					{ "name": "KERNEL", "class_name": "Kernel" },
					{ "name": "COORDINATOR", "class_name": "Coordinator" }
				]
			},
			"ratelimits": [{ "name": "REQUESTS", "namespace_id": "7402", "simple": { "limit": 30, "period": 60 } }],
			"vars": {
				"ALLOWED_ORIGINS": "https://preview.dewml.dev",
				"TURNSTILE_HOSTNAMES": "preview.dewml.dev",
				"TURNSTILE_TEST_KEYS": "accept",
				// Two hours a day.
				"BUDGET_SECONDS": "7200",
				"MAX_SESSIONS": "2",
				"WALL_SECONDS": "1200",
				"WARM_SECONDS": "600",
				"IDLE_SECONDS": "300",
				"CPU_SECONDS": "900",
				"IP_WINDOW_SECONDS": "600",
				// Test runs start sessions back to back.
				"IP_STARTS": "10"
			}
		}
	}
}
