---
// Concept B: a model trained with Dew, running on the visitor's GPU. A cloud of
// noise flows into the word, one Euler step of the network per frame.
import manifest from '../../../public/b/model.json';
import Concept from '../../layouts/Concept.astro';

const W = 120;
const H = 52;
// t against the step on the sampler's grid, t = (1 - step / steps)^1.5.
const curve = Array.from({ length: manifest.sample_steps + 1 }, (_, step) => {
	const t = Math.pow(1 - step / manifest.sample_steps, 1.5);
	return `${step ? 'L' : 'M'}${((step / manifest.sample_steps) * W).toFixed(2)} ${((1 - t) * H).toFixed(2)}`;
}).join(' ');
const minutes = Math.max(1, Math.round(manifest.train_seconds / 60));
---

<Concept
	title="Dew: train models with JAX and Flax"
	description="Dew is a JAX and Flax framework for training language models, diffusion models and JEPA encoders, on one device or a mesh of GPUs or TPUs."
	fallback="/b/fallback.webp"
>
	<canvas slot="stage" data-stage aria-hidden="true"></canvas>
	<div slot="hud" class="hud" aria-hidden="true">
		<svg viewBox={`-2 -4 ${W + 4} ${H + 8}`}>
			<line class="axis" x1="0" y1={H} x2={W} y2={H}></line>
			<path class="curve" d={curve}></path>
			<circle class="dot" r="2.6" cx="0" cy="0" data-dot></circle>
		</svg>
		<div>
			<div>rectified flow, on your GPU</div>
			<div><strong data-step>Euler step 0/{manifest.sample_steps}</strong></div>
			<div data-t>t 1.00</div>
			<div class="hud-note">
				{manifest.parameters.toLocaleString('en-US')} parameters, trained with Dew in {minutes} min on {manifest.cpu} CPU cores
			</div>
		</div>
	</div>
	<style>
		.hud-note {
			max-width: 13rem;
			margin-top: 0.35rem;
			color: var(--muted);
			white-space: normal;
		}
	</style>
</Concept>

<script>
	import { startParticles, type Manifest } from '../../b/particles';

	const hero = document.querySelector<HTMLElement>('[data-hero]')!;
	const canvas = hero.querySelector<HTMLCanvasElement>('[data-stage]')!;
	const stepText = hero.querySelector<HTMLElement>('[data-step]')!;
	const tText = hero.querySelector<HTMLElement>('[data-t]')!;
	const dot = hero.querySelector<SVGCircleElement>('[data-dot]')!;

	const start = async () => {
		const [manifest, weights] = await Promise.all([
			fetch('/b/model.json').then((response) => response.json() as Promise<Manifest>),
			fetch('/b/model.bin').then((response) => response.arrayBuffer()),
		]);
		const readout = (step: number, t: number) => {
			stepText.textContent = `Euler step ${step}/${manifest.sample_steps}`;
			tText.textContent = `t ${t.toFixed(2)}`;
			dot.setAttribute('cx', ((step / manifest.sample_steps) * 120).toFixed(2));
			dot.setAttribute('cy', ((1 - t) * 52).toFixed(2));
		};
		const field = startParticles(hero, canvas, manifest, new Float32Array(weights), readout);
		if (!field) hero.classList.add('no-gl');
	};
	start().catch((error) => {
		console.error(error);
		hero.classList.add('no-gl');
	});
</script>
