---
// Concept C: the page is a sampler. Every figure is one prompt's real sampling
// trajectory; the hero plays its own, and scrolling runs each section's.
import Concept from '../../layouts/Concept.astro';
import registries from '../../../../src/generated/registries.json';

const solvers = registries.samplers.filter((entry: { object: string }) => entry.object.startsWith('dew.sampling.')).length;

const sections = [
	{ id: 'diffusion', title: 'Image and video diffusion', text: `DiT, U-Net and MMDiT backbones, ${solvers} solvers, classifier-free guidance.` },
	{ id: 'language', title: 'Language models', text: 'Pretraining, chat fine-tuning and cached generation on one trainer.' },
	{ id: 'distributed', title: 'One mesh', text: 'MeshSpec(fsdp=4, tensor=2) runs the same code on eight devices.' },
	{ id: 'posttraining', title: 'Post-training', text: 'SFT, DPO, GRPO and PPO continue the weights you trained.' },
];
---

<Concept
	title="Dew: train models with JAX and Flax"
	description="Dew is a JAX and Flax framework for training language models, diffusion models and JEPA encoders, on one device or a mesh of GPUs or TPUs."
>
	<div slot="stage" class="c-hero">
		<figure class="replay" data-replay="/c/hero" data-autoplay>
			<div class="replay-frame">
				<img class="replay-still" src="/c/hero/final.webp" alt="" width="256" height="256" />
				<canvas aria-hidden="true"></canvas>
			</div>
			<figcaption>
				<span class="replay-prompt" data-prompt></span>
				<span class="replay-readout" data-readout></span>
				<span class="replay-controls">
					<button type="button" data-view="x0" aria-pressed="true">predicted x₀</button>
					<button type="button" data-view="xt" aria-pressed="false">noisy x_t</button>
					<button type="button" data-again>again</button>
				</span>
			</figcaption>
		</figure>
	</div>

	{
		sections.map((section) => (
			<section class="c-section" data-section>
				<div class="c-sticky">
					<div class="c-copy">
						<h2>{section.title}</h2>
						<p>{section.text}</p>
					</div>
					<figure class="replay" data-replay={`/c/${section.id}`}>
						<div class="replay-frame">
							<img class="replay-still" src={`/c/${section.id}/final.webp`} alt="" width="256" height="256" loading="lazy" />
							<canvas aria-hidden="true" />
						</div>
						<figcaption>
							<span class="replay-prompt" data-prompt />
							<span class="replay-readout" data-readout />
						</figcaption>
					</figure>
				</div>
			</section>
		))
	}
	<p class="c-provenance" data-provenance></p>

	<style is:global>
		.c-hero {
			position: absolute;
			top: 50%;
			right: clamp(1.25rem, 5vw, 5rem);
			transform: translateY(-54%);
			width: min(46vw, 72vh, 36rem);
		}

		.replay {
			margin: 0;
		}

		.replay-frame {
			position: relative;
			aspect-ratio: 1;
			border-radius: 0.75rem;
			overflow: hidden;
			background: #0c1417;
			box-shadow:
				0 0 0 1px var(--rule),
				0 30px 80px rgba(0, 0, 0, 0.45);
		}

		.replay-frame canvas,
		.replay-frame .replay-still {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			display: block;
		}

		/* Above .hero canvas, which puts full-screen canvases behind the hero copy. */
		.replay .replay-frame canvas {
			z-index: 1;
			opacity: 0;
			transition: opacity 200ms ease;
		}

		.replay.live .replay-frame canvas {
			opacity: 1;
		}

		.replay figcaption {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.35rem 1rem;
			margin-top: 0.8rem;
			font: 500 0.75rem/1.5 var(--mono);
			color: var(--muted);
		}

		.replay-prompt {
			flex-basis: 100%;
			color: var(--text-2);
		}

		.replay-readout {
			font-variant-numeric: tabular-nums;
		}

		.replay-controls {
			display: flex;
			gap: 0.35rem;
		}

		.replay-controls button {
			border: 1px solid var(--rule);
			border-radius: 999px;
			background: transparent;
			color: var(--muted);
			font: inherit;
			padding: 0.1rem 0.6rem;
			cursor: pointer;
		}

		.replay-controls button[aria-pressed='true'] {
			color: var(--text);
			border-color: rgba(95, 220, 201, 0.55);
		}

		.c-section {
			height: 230vh;
			position: relative;
		}

		.c-sticky {
			position: sticky;
			top: 0;
			height: 100vh;
			height: 100svh;
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: center;
			gap: 3rem;
			padding: 0 clamp(1.25rem, 5vw, 5rem);
			max-width: 80rem;
			margin: 0 auto;
		}

		.c-copy h2 {
			margin: 0;
			font: 600 clamp(2rem, 4vw, 3.2rem) / 1.05 var(--display);
			letter-spacing: -0.02em;
		}

		.c-copy p {
			margin: 1rem 0 0;
			max-width: 28rem;
			font-size: 1.1rem;
			line-height: 1.55;
			color: var(--text-2);
		}

		.c-sticky .replay {
			width: min(40vw, 70vh, 34rem);
			justify-self: end;
		}

		.c-provenance {
			max-width: 44rem;
			margin: 0 auto;
			padding: 4rem clamp(1.25rem, 5vw, 5rem) 5rem;
			font-size: 0.85rem;
			line-height: 1.6;
			color: var(--muted);
		}

		@media (max-width: 50rem) {
			.c-hero {
				top: 4.5rem;
				right: auto;
				left: 50%;
				transform: translateX(-50%);
				width: min(88vw, 44vh);
			}
			.c-hero figcaption {
				display: none;
			}
			.c-sticky {
				grid-template-columns: minmax(0, 1fr);
				align-content: center;
				gap: 1.5rem;
			}
			.c-sticky .replay {
				width: min(88vw, 52vh);
				justify-self: center;
				order: -1;
			}
		}
	</style>
</Concept>

<script>
	import { Replay } from '../../c/replay';
	import { prefersReducedMotion, runLoop } from '../../lib/gl';

	const reduced = prefersReducedMotion();
	const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

	function readout(figure: HTMLElement, replay: Replay) {
		const { step, steps, sigma } = replay.readout();
		const text = `step ${step}/${steps}${sigma === null ? '' : ` · σ ${sigma.toFixed(2)}`}`;
		const element = figure.querySelector<HTMLElement>('[data-readout]');
		if (element && element.textContent !== text) element.textContent = text;
	}

	async function mount(figure: HTMLElement): Promise<Replay | null> {
		const canvas = figure.querySelector('canvas')!;
		const replay = await Replay.load(canvas, figure.dataset.replay!);
		if (!replay) return null;
		const prompt = figure.querySelector<HTMLElement>('[data-prompt]');
		if (prompt) prompt.textContent = `“${replay.meta.prompt}”${replay.meta.placeholder ? ' (placeholder frames)' : ''}`;
		figure.classList.add('live');
		return replay;
	}

	// The hero plays its trajectory once on arrival; the buttons switch views and play it again.
	const hero = document.querySelector<HTMLElement>('[data-autoplay]');
	if (hero) {
		mount(hero).then((replay) => {
			if (!replay) return;
			let start = performance.now();
			const duration = 3600;
			if (reduced) replay.step = replay.meta.frames - 1;
			runLoop(hero.querySelector('canvas')!, () => {
				if (!reduced) {
					const t = Math.min(1, (performance.now() - start) / duration);
					replay.step = ease(t) * (replay.meta.frames - 1);
				}
				replay.draw();
				readout(hero, replay);
			});
			hero.querySelector('[data-again]')?.addEventListener('click', () => (start = performance.now()));
			for (const button of hero.querySelectorAll<HTMLButtonElement>('[data-view]')) {
				button.addEventListener('click', async () => {
					const noisy = button.dataset.view === 'xt';
					if (noisy) await replay.loadNoisy();
					replay.noisy = noisy ? 1 : 0;
					for (const other of hero.querySelectorAll<HTMLButtonElement>('[data-view]')) {
						other.setAttribute('aria-pressed', String(other === button));
					}
				});
			}
			const provenance = document.querySelector<HTMLElement>('[data-provenance]');
			if (provenance) {
				const { sampler, steps, cfg, placeholder } = replay.meta;
				provenance.textContent = placeholder
					? 'These frames are placeholders, made by noising a still image. They will be replaced by recorded trajectories from a text-to-image model sampled with Dew.'
					: `Every figure on this page is a recorded sampling trajectory: the model's predicted image at each of ${steps} ${sampler} steps${cfg ? ` with guidance ${cfg}` : ''}.`;
			}
		});
	}

	// Each section's figure runs its sampler with the scroll: noise as it enters, the sample when it settles.
	for (const section of document.querySelectorAll<HTMLElement>('[data-section]')) {
		const figure = section.querySelector<HTMLElement>('[data-replay]')!;
		let replay: Replay | null = null;
		let loading = false;
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting) || loading) return;
				loading = true;
				observer.disconnect();
				mount(figure).then((loaded) => {
					replay = loaded;
					if (!replay) return;
					runLoop(figure.querySelector('canvas')!, () => {
						if (!replay) return;
						const rect = section.getBoundingClientRect();
						const range = rect.height - innerHeight;
						const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, range)));
						// Hold the noise briefly, run the sampler, then hold the sample.
						const t = Math.min(1, Math.max(0, (progress - 0.08) / 0.72));
						replay.step = (reduced ? 1 : t) * (replay.meta.frames - 1);
						replay.draw();
						readout(figure, replay);
					});
				});
			},
			{ rootMargin: '100% 0px' },
		);
		observer.observe(section);
	}
</script>
