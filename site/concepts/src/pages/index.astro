---
// The prototypes side by side, for review. Each also has its own host: concept-a.dewml.dev and so on.
import '../styles/concepts.css';

const concepts = [
	{ href: '/a/', name: 'A. Condensation', text: 'Fog on glass clears into drops that spell dew. Every pixel walks the reverse process of a cosine schedule; your pointer breathes fog back on.' },
	{ href: '/b/', name: 'B. A model in your browser', text: 'A trained diffusion model samples an image from noise on your GPU, step by step, a new one on every visit.' },
	{ href: '/c/', name: 'C. The page is a sampler', text: 'Scrolling runs a deterministic sampler: each section resolves out of the same noise.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Dew landing page prototypes</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<style>
			main {
				max-width: 44rem;
				margin: 0 auto;
				padding: 4rem 1.5rem;
			}
			h1 {
				font: 600 2rem/1.1 Georgia, serif;
			}
			a.concept {
				display: block;
				margin-top: 1rem;
				padding: 1rem 1.2rem;
				border: 1px solid var(--rule);
				border-radius: 0.6rem;
				text-decoration: none;
			}
			a.concept:hover {
				border-color: var(--accent);
			}
			a.concept strong {
				display: block;
				margin-bottom: 0.3rem;
			}
			a.concept span {
				color: var(--text-2);
				font-size: 0.95rem;
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Landing page prototypes</h1>
			{
				concepts.map((concept) => (
					<a class="concept" href={concept.href}>
						<strong>{concept.name}</strong>
						<span>{concept.text}</span>
					</a>
				))
			}
		</main>
	</body>
</html>
