{
	"name": "dewml-site",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"content": "node scripts/sync-docs.mjs && node scripts/render-notebooks.mjs && pnpm content:python",
		"content:python": "uv run --no-project --python 3.12 --with griffe==2.3.0 python scripts/gen_api.py && JAX_PLATFORMS=cpu uv run --no-project --python 3.12 --with-editable .. python scripts/gen_models.py && python3 scripts/gen_examples.py",
		"dev": "pnpm content && astro dev",
		"build": "pnpm content && astro build",
		"preview": "astro preview",
		"check": "astro check",
		"deploy": "wrangler deploy && wrangler deploy -c deploy/www/wrangler.jsonc",
		"deploy:preview": "wrangler deploy -c deploy/preview/wrangler.jsonc",
		"live:deploy": "node live/deploy.mjs",
		"live:check": "tsc -p live/tsconfig.json",
		"live:test": "node --test --test-reporter=spec \"live/test/*.test.mjs\"",
		"test": "node --test --test-reporter=spec \"test/*.test.mjs\""
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.1",
		"@astrojs/starlight": "0.42.3",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"astro": "7.3.4",
		"katex": "0.18.7",
		"rehype-katex": "7.0.1",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"remark-parse": "11.0.0",
		"sharp": "0.35.4",
		"shiki": "4.4.3",
		"starlight-links-validator": "0.26.0",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261001.1",
		"esbuild": "0.28.1",
		"miniflare": "5.20260930.0-alpha",
		"playwright-core": "1.59.1",
		"typescript": "6.0.3",
		"wrangler": "4.145.0"
	}
}
